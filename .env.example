# ==================== PORTS ====================
API_PORT=3000
WEB_PUBLIC_PORT=3001
WEB_WORKSPACE_PORT=3002
WEB_ADMIN_PORT=3003
POSTGRES_PORT=5432
REDIS_PORT=6379
PROXY_HTTP_PORT=80
WORKER_HEALTH_PORT=3004

# ==================== DATABASE ====================
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=eventflow_db
DATABASE_URL=postgresql://eventflow:replace-with-local-postgres-password@postgres:5432/eventflow_db?schema=public

# ==================== API ====================
JWT_SECRET=replace-with-long-random-jwt-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
UPLOADS_DIR=/data/uploads
# Private storage for participant file-upload answers. MUST be outside UPLOADS_DIR
# (the /uploads static mount) so these files are never served statically — they
# are downloadable only via the authorized, tenant-checked API endpoint.
REGISTRATION_UPLOADS_DIR=/data/registration-files
# Private storage for mobile app builds (APK/IPA) distributed to the team via
# the super-admin panel. Also outside UPLOADS_DIR — download only through the
# SUPER_ADMIN-gated API endpoint.
APP_BUILDS_DIR=/data/app-builds
CORS_ORIGINS=http://localhost,http://app.localhost,http://admin.localhost,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Ticket QR signing secret — HMAC-SHA256 key for signing ticket QR payloads.
# Generate: openssl rand -base64 48
# In production: required (env validation rejects empty/insecure-default values).
TICKET_QR_SECRET=replace-with-long-random-ticket-qr-secret


# Server-side translation provider. Never expose TAHRIRCHI_TOKEN to frontend apps.
TAHRIRCHI_TOKEN=
TAHRIRCHI_URL=https://websocket.tahrirchi.uz/translate-v2
TAHRIRCHI_MODEL=sayqalchi
TAHRIRCHI_TIMEOUT_MS=15000

# ==================== PUSH (Expo Push Service) ====================
# Тумблер push-канала уведомлений (BL-14). Включать ТОЛЬКО после загрузки
# FCM server key + APNs key в Expo-проект (BL-12, внешняя задача владельца):
# выключенный канал мягко деградирует в email-fallback.
EXPO_PUSH_ENABLED=false
# Нужен, только если в Expo-проекте включён Enhanced Security for Push.
EXPO_ACCESS_TOKEN=

# ==================== OAUTH ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://api.localhost/api/v1/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://api.localhost/api/v1/auth/linkedin/callback

# ==================== MAIL ====================
# Local dev: the bundled Mailpit catcher (web UI at http://localhost:8025).
# Production: switch to a real SMTP host (e.g. smtp.gmail.com:587) with creds.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
# Use a domain you control with SPF + DKIM + DMARC aligned to this address.
MAIL_FROM="EventFlow <noreply@eventflow.uz>"
# Email footer / deliverability identity
MAIL_BRAND_NAME=EventFlow
MAIL_SITE_URL=https://eventflow.uz
MAIL_SUPPORT_EMAIL=support@eventflow.uz
MAIL_REPLY_TO=support@eventflow.uz
MAIL_LEGAL_NAME=EventFlow
MAIL_POSTAL_ADDRESS="Tashkent, Uzbekistan"
# HMAC secret for signed one-click unsubscribe tokens. Set a long random
# value in production; falls back to JWT_SECRET if unset.
EMAIL_UNSUBSCRIBE_SECRET=
# RFC 8058 one-click POST endpoint (the API). Default points at the API host.
MAIL_UNSUBSCRIBE_API_URL=https://api.eventflow.uz/api/v1/email/unsubscribe
# Human-facing unsubscribe confirmation page (web-public).
MAIL_UNSUBSCRIBE_PAGE_URL=https://eventflow.uz/unsubscribe
# Absolute HTTPS URL of the raster (PNG) header logo. Must be raster, not SVG
# (Gmail/Outlook do not render SVG). Served from the public site assets.
MAIL_LOGO_URL=https://eventflow.uz/assets/email-logo.png
INTERNAL_JOB_TOKEN=replace-with-long-random-internal-job-token
METRICS_INTERNAL_TOKEN=replace-with-long-random-internal-metrics-token
METRICS_ENABLED=true
DB_SLOW_QUERY_THRESHOLD_MS=500

# ==================== FRONTEND URLS ====================
FRONTEND_APP_URL=http://app.localhost
FRONTEND_ADMIN_URL=http://admin.localhost
FRONTEND_PUBLIC_URL=http://localhost
PUBLIC_BASE_URL=http://localhost
WORKSPACE_BASE_URL=http://app.localhost
ADMIN_BASE_URL=http://admin.localhost
API_BASE_URL=http://api.localhost
PUBLIC_HOST=localhost
WORKSPACE_HOST=app.localhost
ADMIN_HOST=admin.localhost

# web-public analytics (GTM + Yandex.Metrika). Empty = tag disabled.
# Set ONLY on the production public site so dev/stage traffic doesn't
# pollute prod stats.
PUBLIC_GTM_ID=
PUBLIC_YM_ID=
API_HOST=api.localhost
NEXT_PUBLIC_API_URL=http://api.localhost
NEXT_PUBLIC_APP_URL=http://app.localhost
NEXT_PUBLIC_PUBLIC_URL=http://localhost
# Leave empty to hide OAuth buttons in production until each provider is proven end-to-end.
NEXT_PUBLIC_OAUTH_PROVIDERS=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
VITE_API_URL=http://api.localhost/api
VITE_MEDIA_URL=http://api.localhost
VITE_PUBLIC_SITE_URL=http://localhost
# Redirect target for legacy /admin/* links inside workspace
VITE_ADMIN_APP_URL=http://admin.localhost
# Reverse link target from dedicated admin app back to organizer workspace
VITE_WORKSPACE_APP_URL=http://app.localhost
VITE_YANDEX_MAPS_API_KEY=

# ==================== REDIS ====================
REDIS_URL=redis://redis:6379
API_INTERNAL_URL=http://api:3000/api/v1/internal/jobs

# ==================== SCALE / QUEUES ====================
WORKER_PROFILE=all
WORKER_MAIL_CONCURRENCY=4
WORKER_TICKETS_CONCURRENCY=2
WORKER_CERTIFICATES_CONCURRENCY=1
WORKER_BADGES_CONCURRENCY=1
TICKETS_SYNC_WAIT_TIMEOUT_MS=5000
TICKETS_SYNC_WAIT_MAX_QUEUE_DEPTH=2
TICKETS_SYNC_WAIT_MAX_ZIP_REGISTRATIONS=10
TICKETS_MAX_ZIP_REGISTRATIONS=250
TICKETS_QUEUE_BACKPRESSURE_MAX_DEPTH=50
CERTIFICATES_SYNC_WAIT_TIMEOUT_MS=5000
CERTIFICATES_SYNC_WAIT_MAX_QUEUE_DEPTH=1
CERTIFICATES_SYNC_WAIT_MAX_REGISTRATIONS=10
CERTIFICATES_MAX_BATCH_REGISTRATIONS=500
CERTIFICATES_QUEUE_BACKPRESSURE_MAX_DEPTH=20

# ── Платёжные провайдеры (M-5, 🔒 внешний гейт: мерчант-онбординг) ──────────
# Payme (Paycom) — провайдер №1 (решение C-3). Без кредов вебхук отвечает 503.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
# Click — фоллоу-ап после Payme (адаптер добавляется по тому же интерфейсу).
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# VIA (via.uz) — hosted-invoice чекаут (UZCARD/HUMO). Все три creds обязательны
# вместе (env-валидация запрещает полу-конфигурацию); без них провайдер невидим.
# Sandbox: VIA_API_BASE_URL=https://api.viasandbox.uz (дефолт — https://api.via.uz).
# VIA_ACCOUNT_FIELD — ключ поля услуги мерчанта, согласованный при онбординге.
VIA_CLIENT_ID=
VIA_CLIENT_SECRET=
VIA_MERCHANT_ID=
VIA_API_BASE_URL=
VIA_ACCOUNT_FIELD=
# Секрет endpoint'а уведомлений VIA (колбэки не подписаны — токен-капабилити в URL):
# POST /api/v1/payments/webhooks/via/<VIA_WEBHOOK_TOKEN>. Длинная случайная строка.
VIA_WEBHOOK_TOKEN=
# Allowlist исходящих IP VIA (балансировщики LB1/LB2, выданы VIA 2026-07-24).
# Пусто — проверка IP выключена (остаётся токен). Продублировать в nginx (allow/deny).
VIA_WEBHOOK_ALLOWED_IPS=
