# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_MEDIA_URL=http://localhost:3000
VITE_API_TIMEOUT=15000

# Публичный сайт (как видят пользователи). Ссылки «Открыть статью», «Посмотреть на сайте».
VITE_PUBLIC_SITE_URL=http://localhost:3001
# Отдельное super-admin приложение. Старые /admin/* deep-link в workspace делают redirect сюда.
VITE_ADMIN_APP_URL=http://localhost:3003

# Yandex Maps JavaScript API (для выбора места и карты на странице события)
# Получить ключ: https://developer.tech.yandex.ru/
VITE_YANDEX_MAPS_API_KEY=
