{
  "name": "@eventflow/api",
  "version": "1.0.0",
  "description": "EventFlow - Event Management Platform Backend",
  "author": "EventFlow Team",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prebuild": "npm run db:generate",
    "build": "nest build",
    "openapi:export": "ts-node --project tsconfig.json src/openapi/export-openapi.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "backfill:event-city": "node dist/src/scripts/backfill-event-city.js",
    "backfill:event-city:dev": "ts-node --project tsconfig.json src/scripts/backfill-event-city.ts",
    "email:smoke:prod": "node dist/src/scripts/email-smoke.js",
    "email:smoke:dev": "ts-node --project tsconfig.json src/scripts/email-smoke.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "db:generate": "prisma generate",
    "artifact-recipients:backfill": "ts-node prisma/backfill-event-artifact-recipients.ts",
    "tickets:backfill": "ts-node prisma/backfill-ticket-numbers.ts",
    "db:push": "prisma db push",
    "iam:backfill": "ts-node prisma/backfill-iam.ts",
    "iam:preflight": "ts-node prisma/preflight-scope-migration.ts",
    "docker:dev": "docker compose up -d",
    "docker:dev:build": "docker compose up -d --build",
    "docker:dev:down": "docker compose down",
    "docker:dev:logs": "docker compose logs -f api",
    "docker:db": "docker compose up -d postgres",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "deploy": "./deploy.sh",
    "backup": "./backup-db.sh",
    "backup:list": "./backup-db.sh list",
    "backup:restore": "./backup-db.sh restore",
    "health": "./health-check.sh",
    "pre-deploy": "./pre-deploy-check.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@openfonts/inter_all": "^1.0.2",
    "@openfonts/lora_all": "^1.44.2",
    "@openfonts/merriweather_all": "^1.44.2",
    "@openfonts/montserrat_all": "^1.44.2",
    "@openfonts/nunito_all": "^1.0.1",
    "@openfonts/open-sans_all": "^1.44.2",
    "@openfonts/pt-sans_all": "^1.44.2",
    "@openfonts/pt-serif_all": "^1.44.2",
    "@openfonts/raleway_all": "^0.0.1",
    "@openfonts/roboto_all": "^1.44.1",
    "@openfonts/roboto-slab_all": "^1.0.1",
    "@openfonts/ubuntu_all": "^1.44.2",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@types/archiver": "^7.0.0",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.61.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^5.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-linkedin-oauth2": "^1.5.6",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.2",
    "prisma": "^7.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "overrides": {
    "inflight": "^2.0.0",
    "glob": "^10.3.10",
    "mjml": "5.4.0",
    "liquidjs": "10.27.2",
    "multer": "2.2.0",
    "form-data": "4.0.6",
    "undici": "6.27.0",
    "path-to-regexp": "8.4.2",
    "lodash": "4.18.1",
    "fast-uri": "3.1.3",
    "mailparser": "3.9.14",
    "tmp": "0.2.7",
    "qs": "6.15.3",
    "fast-xml-parser": "4.5.7",
    "serialize-javascript": "6.0.2",
    "minimatch": "9.0.9",
    "picomatch": "4.0.5",
    "js-cookie": "3.0.8",
    "linkify-it": "5.0.2",
    "handlebars": "4.7.9",
    "nodemailer": "$nodemailer"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:uuid|uncrypto)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
