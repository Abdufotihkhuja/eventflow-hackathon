### ============================================
### ТЕСТЫ НА ОШИБКИ
### ============================================

### ============================================
### Ошибка 1: Загрузка без авторизации
### ============================================

POST {{baseUrl}}/events/{{eventId}}/agenda/{{agendaItemId}}/materials/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.pdf"
Content-Type: application/pdf

< ./uploads/materials/test.pdf
------WebKitFormBoundary7MA4YWxkTrZu0gW--

# Ожидается: 401 Unauthorized

### ============================================
### Ошибка 2: Загрузка участником (не организатором)
### ============================================

POST {{baseUrl}}/events/{{eventId}}/agenda/{{agendaItemId}}/materials/upload
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test.pdf"
Content-Type: application/pdf

< ./uploads/materials/test.pdf
------WebKitFormBoundary7MA4YWxkTrZu0gW--

# Ожидается: 403 Forbidden

### ============================================
### Ошибка 3: Загрузка недопустимого типа файла
### ============================================

POST {{baseUrl}}/events/{{eventId}}/agenda/{{agendaItemId}}/materials/upload
Authorization: Bearer {{organizerToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="script.exe"
Content-Type: application/x-msdownload

< ./uploads/materials/script.exe
------WebKitFormBoundary7MA4YWxkTrZu0gW--

# Ожидается: 400 Bad Request (Недопустимый тип файла)

### ============================================
### Ошибка 4: Удаление несуществующего материала
### ============================================

DELETE {{baseUrl}}/events/{{eventId}}/agenda/{{agendaItemId}}/materials
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "fileUrl": "/uploads/materials/non-existent-uuid.pdf"
}

# Ожидается: 404 Not Found

### ============================================
### Ошибка 5: Скачивание без параметра fileUrl
### ============================================

GET {{baseUrl}}/events/{{eventId}}/agenda/{{agendaItemId}}/materials/download
Authorization: Bearer {{organizerToken}}

# Ожидается: 400 Bad Request (Параметр fileUrl обязателен)

### ============================================
### Ошибка 6: Path Traversal атака
### ============================================

GET {{baseUrl}}/events/{{eventId}}/agenda/{{agendaItemId}}/materials/download?fileUrl=../../../etc/passwd
Authorization: Bearer {{organizerToken}}

# Ожидается: 400 Bad Request (Недопустимое имя файла)

###

DELETE {{baseUrl}}/events/{{eventId}}/agenda/{{agendaItemId}}/materials
Authorization: Bearer {{organizerToken}}
Content-Type: application/json

{
  "fileUrl": "../../uploads/materials/uuid.pdf"
}

# Ожидается: 400 Bad Request (Недопустимое имя файла)

### ============================================
### ПРИМЕЧАНИЯ
### ============================================

# 1. Замените переменные в начале файла:
#    - @organizerToken: токен организатора
#    - @userToken: токен обычного пользователя
#    - @eventId: ID мероприятия
#    - @agendaItemId: ID элемента агенды

# 2. Для загрузки файлов убедитесь, что файлы существуют:
#    - ./uploads/materials/presentation.pdf
#    - ./uploads/materials/document.docx
#    - и т.д.

# 3. Поддерживаемые типы файлов:
#    - PDF, DOC, DOCX
#    - PPT, PPTX
#    - XLS, XLSX
#    - JPEG, PNG, GIF, WebP
#    - ZIP, RAR
#    - TXT, MD

# 4. Ограничения:
#    - Максимальный размер файла: 50 MB
#    - Максимум файлов за раз: 10

# 5. Права доступа:
#    - Загрузка/удаление: только организаторы
#    - Просмотр/скачивание: все авторизованные пользователи
