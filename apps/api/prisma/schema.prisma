  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([collectionId, eventId])
  @@index([collectionId])
  @@index([eventId])
  @@map("event_collection_items")
}

// ==================== EMAIL UNSUBSCRIBE (Отписки от email-уведомлений) ====================

model EmailUnsubscribe {
  id             String   @id @default(uuid()) @db.Uuid
  email          String
  userId         String?  @map("user_id") @db.Uuid
  category       String
  unsubscribedAt DateTime @default(now()) @map("unsubscribed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([email, category])
  @@index([email])
  @@map("email_unsubscribes")
}

// ==================== ADMIN AUDIT LOG ====================

/// Неизменяемый журнал опасных действий супер-админа (например, hard delete).
/// Намеренно НЕ имеет внешних ключей на удаляемые сущности, чтобы запись
/// переживала удаление и не каскадировалась вместе с ним.
model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String // 'USER_HARD_DELETE' | 'ORGANIZATION_HARD_DELETE'
  actorId     String   @map("actor_id") @db.Uuid // SuperAdmin.id
  actorEmail  String?  @map("actor_email")
  targetType  String   @map("target_type") // 'USER' | 'ORGANIZATION'
  targetId    String   @map("target_id") @db.Uuid
  targetLabel String?  @map("target_label") // email пользователя или название организации
  metadata    Json     @default("{}") // снимок зависимостей и прочий контекст
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ============================================================================
// МОНЕТИЗАЦИЯ (Stage 2). Все модели/энумы ниже — аддитивные.
// Дизайн: docs/monetization/09-critic-report.md (CR-1, CR-2) + 10-decisions.md.
// Деньги: BigInt минорные единицы (тийины/центы), string-on-wire (D-3).
// Каталог НЕ хранит отображаемые строки — i18n по ключу (CR-19).
// ============================================================================

/// Ключ тарифа (§1 бизнес-модели). Расширение — additive ALTER TYPE.
enum PlanKey {
  START
  PRO
  EXCLUSIVE
}

/// Окно квоты генераций: календарный месяц (START) или период пакета (платные) — решение A-5.
enum GenerationWindow {
  CALENDAR_MONTH
  PACK_PERIOD
}

/// Тир статистики. На запуске у всех BASIC (B-4: прогнозирование не продаётся, пока не построено).
enum StatsTier {
  BASIC
  FORECASTING
  FORECASTING_SLA
}

/// Режим QR check-in по тарифу (OQ-4/E-9: расширенные режимы зарезервированы).
enum QrCheckInMode {
  ARRIVAL_ONLY
  EXTENDED
}

/// Вид add-on SKU: пакет монет или рекламный продукт (CR-2 — единый каталог).
enum AddonSkuKind {
  COIN_PACK
  AD_PRODUCT
}

/// Метрика монет/потребления (CR-26: AI хранится в секундах).
enum CoinMetric {
  AI_SECONDS
  GENERATION_UNITS
}

/// Единица тарификации рекламного SKU (решение D-2 группы D).
enum AdBillingUnit {
  PER_WEEK
  PER_CAMPAIGN
  PER_MESSAGE
}

/// Глобальный каталог тарифов (D-4). Изменяемые строки + снапшоты на покупках
/// (CR-1: без PlanVersion; история правок — AdminAuditLog PRICE_SET).
/// Цены NULL и isPurchasable=false до установки владельцем (D-15).
model Plan {
  id  String  @id @default(uuid()) @db.Uuid
  key PlanKey @unique

  /// Цена пакета в тийинах UZS; NULL = не установлена (продажа невозможна).
  priceAmountMinor BigInt? @map("price_amount_minor")
  /// USD-якорь в центах: до Stripe — только отображение; после M-18 — реально списываемая цена.
  usdAnchorCents   Int?    @map("usd_anchor_cents")
  /// Продаваемость (START — дефолтный бесплатный тариф, не продаётся).
  isPurchasable    Boolean @default(false) @map("is_purchasable")
  /// Виден ли в каталоге (public/cabinet). START виден, но не покупается.
  isActive         Boolean @default(false) @map("is_active")

  /// Кредиты на события в пакете (0/5/10) и срок пакета в днях (§2.1: 90; NULL у START).
  eventCredits Int  @default(0) @map("event_credits")
  validityDays Int? @map("validity_days")

  /// Комиссия платформы в базисных пунктах (1200/800/600).
  commissionBps Int @map("commission_bps")

  /// Квоты (снапшотятся на PlanPurchase при покупке).
  aiMinutesMonthly        Int              @default(0) @map("ai_minutes_monthly")
  generationCredits       Int              @default(0) @map("generation_credits")
  generationWindow        GenerationWindow @default(CALENDAR_MONTH) @map("generation_window")
  staffSeats              Int              @default(1) @map("staff_seats")
  maxParticipantsPerEvent Int?             @map("max_participants_per_event")
  taskBoardEnabled        Boolean          @default(false) @map("task_board_enabled")
  statsTier               StatsTier        @default(BASIC) @map("stats_tier")
  qrMode                  QrCheckInMode    @default(ARRIVAL_ONLY) @map("qr_mode")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]
  purchases PlanPurchase[]

  @@map("plans")
}

/// Каталог add-on SKU: пакеты монет + рекламные продукты (CR-2, OQ-A4-4 — один каталог).
model AddonSku {
  id   String       @id @default(uuid()) @db.Uuid
  /// Стабильный код для i18n и кода: COIN_AI_100MIN, COIN_GEN_100, AD_FEATURED_WEEK, ...
  code String       @unique
  kind AddonSkuKind

  /// Для AD_PRODUCT это базовая/floor-цена; конкретный заказ носит свою цену (AdOrder, D-10).
  priceAmountMinor BigInt? @map("price_amount_minor")
  usdAnchorCents   Int?    @map("usd_anchor_cents")
  isActive         Boolean @default(false) @map("is_active")

  /// COIN_PACK: метрика и количество (AI: 6000 секунд = 100 минут; GEN: 100 единиц).
  coinMetric   CoinMetric? @map("coin_metric")
  coinQuantity Int?        @map("coin_quantity")

  /// AD_PRODUCT: единица тарификации.
  adBillingUnit AdBillingUnit? @map("ad_billing_unit")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("addon_skus")
}

/// Вид заказа (CR-15: одна таблица Order для всех видов продаж).
enum OrderKind {
  PLAN
  COIN_PACK
  ADVERTISING
  TICKET_SALE
}

/// Статус заказа. REQUESTED — заявка managed-фазы (M-13-ext, CR-23):
/// организация просит, оператор фулфиллит; c появлением чекаута заказ
/// стартует с PENDING_PAYMENT.
enum OrderStatus {
  REQUESTED
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

/// Платёжный провайдер. MANUAL — офлайн-оплата, записанная оператором (S-4).
/// STRIPE зарезервирован (M-18, внешний гейт — зарубежное юрлицо).
/// VIA — hosted-invoice чекаут (UZCARD/HUMO); подтверждение оплаты ТОЛЬКО
/// серверным опросом статуса инвойса (у VIA нет подписанных вебхуков).
enum PaymentProvider {
  MANUAL
  PAYME
  CLICK
  STRIPE
  VIA
}

enum PaymentTxStatus {
  CREATED
  CONFIRMED
  FAILED
  REVERSED
}

/// Заказ (D-9) — tenant-scoped. Деньги в тийинах (BigInt, D-3).
/// Для TICKET_SALE: registrationId уникален (partial-unique — NULL не
/// конфликтуют), holdExpiresAt — TTL брони места (M-4), commission*-поля —
/// снапшот комиссии на момент создания (M-6, неизменяемая история).
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  kind           OrderKind
  status         OrderStatus @default(REQUESTED)

  planId     String? @map("plan_id") @db.Uuid
  addonSkuId String? @map("addon_sku_id") @db.Uuid
  quantity   Int     @default(1)

  eventId        String? @map("event_id") @db.Uuid
  registrationId String? @unique @map("registration_id") @db.Uuid

  amountMinor           BigInt   @map("amount_minor")
  currency              Currency @default(UZS)
  commissionBpsSnapshot Int?     @map("commission_bps_snapshot")
  commissionAmountMinor BigInt?  @map("commission_amount_minor")

  holdExpiresAt DateTime? @map("hold_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?                @relation(fields: [planId], references: [id], onDelete: Restrict)
  addonSku     AddonSku?            @relation(fields: [addonSkuId], references: [id], onDelete: Restrict)
  event        Event?               @relation("EventTicketOrders", fields: [eventId], references: [id], onDelete: SetNull)
  registration Registration?        @relation("RegistrationTicketOrder", fields: [registrationId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  planPurchase PlanPurchase?
  adOrder      AdOrder?

  @@index([organizationId])
  @@index([kind, status])
  @@index([holdExpiresAt])
  @@map("orders")
}

/// Платёжная транзакция провайдера (D-9). Идемпотентность вебхуков:
/// @@unique([provider, providerTxnId]). payloadScrubbed — ТОЛЬКО вайтлист
/// полей провайдера, без PII/карточных данных (CR-16, инвариант №7).
model PaymentTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  provider      PaymentProvider
  /// Id транзакции у провайдера; для MANUAL — внешний референс, введённый оператором (S-4, обязателен).
  providerTxnId String          @map("provider_txn_id")
  status        PaymentTxStatus @default(CREATED)
  amountMinor   BigInt          @map("amount_minor")
  currency      Currency        @default(UZS)

  payloadScrubbed Json      @default("{}") @map("payload_scrubbed")
  confirmedAt     DateTime? @map("confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxnId])
  @@index([orderId])
  @@map("payment_transactions")
}

/// Статус пакета тарифа (M-2 + §2.4: SUPERSEDED при смене тарифа).
enum PlanPurchaseStatus {
  PENDING_PAYMENT
  ACTIVE
  EXHAUSTED
  EXPIRED
  SUPERSEDED
}

/// Вид корректировки кредитов (append-only; S-3 + §2.4 carry-over + B-1 refund).
enum PlanCreditAdjustmentKind {
  ADMIN_ADJUST
  CARRY_OVER
  REFUND
}

/// Экземпляр купленного (или выданного оператором) пакета тарифа (D-5).
/// Все *Snapshot-поля фиксируются из каталога в момент покупки (CR-1) —
/// последующие правки каталога не меняют проданное.
/// eventCreditsRemaining поддерживается транзакционно (guarded update);
/// истина для сверки — granted + Σadjustments − активные consumptions.
model PlanPurchase {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  orderId        String?            @unique @map("order_id") @db.Uuid
  status         PlanPurchaseStatus @default(PENDING_PAYMENT)

  planKeySnapshot           PlanKey          @map("plan_key_snapshot")
  priceAmountMinorSnapshot  BigInt?          @map("price_amount_minor_snapshot")
  commissionBpsSnapshot     Int              @map("commission_bps_snapshot")
  eventCreditsGranted       Int              @map("event_credits_granted")
  eventCreditsRemaining     Int              @map("event_credits_remaining")
  aiMinutesMonthlySnapshot  Int              @map("ai_minutes_monthly_snapshot")
  generationCreditsSnapshot Int              @map("generation_credits_snapshot")
  generationWindowSnapshot  GenerationWindow @map("generation_window_snapshot")
  staffSeatsSnapshot        Int              @map("staff_seats_snapshot")
  maxParticipantsSnapshot   Int?             @map("max_participants_snapshot")
  taskBoardEnabledSnapshot  Boolean          @map("task_board_enabled_snapshot")
  statsTierSnapshot         StatsTier        @map("stats_tier_snapshot")
  qrModeSnapshot            QrCheckInMode    @map("qr_mode_snapshot")
  validityDaysSnapshot      Int?             @map("validity_days_snapshot")

  /// activatedAt + validityDays (§2.1: 90 дней). NULL до активации.
  activatedAt    DateTime? @map("activated_at")
  expiresAt      DateTime? @map("expires_at")
  supersededAt   DateTime? @map("superseded_at")
  /// Пакет, заменивший этот (смена тарифа §2.4).
  supersededById String?   @map("superseded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  order        Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supersededBy PlanPurchase?            @relation("PlanPurchaseSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   PlanPurchase[]           @relation("PlanPurchaseSupersession")
  consumptions EventCreditConsumption[]
  adjustments  PlanCreditAdjustment[]

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("plan_purchases")
}

/// Потребление кредита события (E-16/OQ-A0-6): одна запись на событие —
/// @@unique([eventId]) даёт идемпотентность «первый переход в PUBLISHED»,
/// re-publish бесплатен. eventId НАМЕРЕННО без FK: история трат переживает
/// удаление события. refundedAt — возврат по B-1 (CANCELLED с 0 APPROVED).
model EventCreditConsumption {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  planPurchaseId String    @map("plan_purchase_id") @db.Uuid
  eventId        String    @unique @map("event_id") @db.Uuid
  consumedAt     DateTime  @default(now()) @map("consumed_at")
  refundedAt     DateTime? @map("refunded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planPurchase PlanPurchase @relation(fields: [planPurchaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([planPurchaseId])
  @@map("event_credit_consumptions")
}

/// Append-only корректировка кредитов пакета (S-3 админ-правки, §2.4 перенос
/// при смене тарифа, B-1 возврат). Никогда не мутирует прошлые записи;
/// createdByAdminId — FK-less (SuperAdmin.id, прецедент archivedById).
model PlanCreditAdjustment {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  planPurchaseId   String                   @map("plan_purchase_id") @db.Uuid
  delta            Int
  kind             PlanCreditAdjustmentKind
  createdByAdminId String?                  @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planPurchase PlanPurchase @relation(fields: [planPurchaseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([planPurchaseId])
  @@map("plan_credit_adjustments")
}

/// Ключ энтайтлмента для per-org оверрайда (D-6). Расширение — additive.
enum EntitlementKey {
  COMMISSION_BPS
  STAFF_SEATS
  MAX_PARTICIPANTS_PER_EVENT
  GENERATION_CREDITS
  AI_MINUTES_MONTHLY
  TASK_BOARD_ENABLED
  STATS_TIER
  QR_MODE
  EVENT_CREDITS
  /// Override-only лимит на общее число созданных событий (тарифного дефолта нет).
  MAX_EVENTS
  /// Per-org включение VIA-платежей (valueBool): true — пилот/тест до общего
  /// запуска, false — точечное отключение; при отсутствии строки действует
  /// глобальный тумблер via_payments (platform_config).
  VIA_PAYMENTS
}

/// Per-org оверрайд энтайтлмента (D-6): супер-адмнские кастомные капы/комиссия
/// (S-5/S-6, OQ-7: reason ОБЯЗАТЕЛЕН) и авто-гранты грандфазеринга (D-14,
/// expiresAt = запуск + 90 дней, решение B-3). Одна активная строка на
/// (org, key): правка перезаписывает строку, история — в AdminAuditLog
/// (CAP_OVERRIDE_SET before/after). Значение — ровно одно из value*-полей
/// по типу ключа: числовые → valueInt, флаги → valueBool, енумы → valueString.
model EntitlementOverride {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  key            EntitlementKey

  valueInt    Int?     @map("value_int")
  valueBool   Boolean? @map("value_bool")
  valueString String?  @map("value_string")

  reason           String
  /// FK-less SuperAdmin.id (прецедент archivedById); NULL для системных грантов миграций (D-14).
  createdByAdminId String?   @map("created_by_admin_id") @db.Uuid
  expiresAt        DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("entitlement_overrides")
}

/// Маска доступа организации (тонкое управление супер-админа поверх ролей):
/// наличие строки = право `permissionCode` ЗАКРЫТО для ВСЕЙ организации,
/// включая владельца (OWNER). Пустая маска = поведение по ролям/тарифу как
/// раньше (обратная совместимость). Маска только УБИРАЕТ права, никогда не
/// выдаёт (выдача — управление ролями). История правок — AdminAuditLog
/// (ACCESS_MASK_SET, before/after списки кодов). createdByAdminId — FK-less
/// SuperAdmin.id (прецедент archivedById).
model OrganizationAccessOverride {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  /// Код права из каталога PERMISSIONS (например 'events:create').
  permissionCode   String   @map("permission_code")
  /// Причина закрытия (необязательна); дублируется в AdminAuditLog.
  reason           String?
  createdByAdminId String?  @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, permissionCode])
  @@index([organizationId])
  @@map("organization_access_overrides")
}

/// Источник списания единицы потребления (OQ-5: сначала квота тарифа, потом монеты).
enum DrainSource {
  PLAN_QUOTA
  COIN
}

/// Append-only событие потребления (D-7, E-10). Идемпотентность метеринга:
/// @@unique([organizationId, metric, idempotencyKey]) — повторная попытка с тем
/// же ключом (ретрай, повторный рендер бейджа PC-8, ретрай settle AI-звонка)
/// не создаёт вторую запись. periodKey — ленивое окно (CR-6, без планировщика):
/// 'YYYY-MM' для календарного месяца, 'pack:<purchaseId>' для периода пакета,
/// 'pack:<purchaseId>:YYYY-MM' для месячных окон AI-минут внутри пакета.
/// drainSource фиксирует источник НАВСЕГДА — смена политики OQ-5 не
/// переписывает историю. quantity: AI — секунды (CR-26), генерации — единицы.
model UsageEvent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  metric         CoinMetric
  quantity       Int
  idempotencyKey String      @map("idempotency_key")
  periodKey      String      @map("period_key")
  drainSource    DrainSource @map("drain_source")

  /// Атрибуция (все FK-less — история переживает удаления).
  planPurchaseId String? @map("plan_purchase_id") @db.Uuid
  eventId        String? @map("event_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, idempotencyKey])
  @@index([organizationId, metric, periodKey])
  @@map("usage_events")
}

/// Агрегированный счётчик окна (D-7): горячий путь чтения «сколько потрачено
/// в этом окне». Поддерживается в одной транзакции с UsageEvent (E-10 guarded
/// update); UsageEvent — истина для сверки. Сбросов НЕТ — новое окно = новая
/// строка с новым periodKey (CR-6: ленивое разрешение вместо планировщика).
model UsageCounter {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  metric         CoinMetric
  periodKey      String     @map("period_key")
  used           Int        @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodKey])
  @@map("usage_counters")
}

/// Вид проводки леджера монет (CR-14; EXPIRY зарезервирован — монеты
/// бессрочны по OQ-5, additive ALTER TYPE если политика изменится).
enum CoinLedgerEntryKind {
  PURCHASE
  COMP_GRANT
  CONSUMPTION
  REVERSAL
}

/// Append-only леджер монет (D-8, CR-14): каждая проводка несёт balanceAfter —
/// баланс метрики ПОСЛЕ проводки (горячее чтение = последняя строка), плюс
/// CHECK (balance_after >= 0) в SQL миграции. SUM(delta) == последний
/// balanceAfter — инвариант сверки (M-9). Единицы: AI — секунды (CR-26).
/// Монеты не истекают и переживают смену/истечение тарифа (OQ-5).
model CoinLedgerEntry {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  metric         CoinMetric
  delta          Int
  balanceAfter   Int                 @map("balance_after")
  kind           CoinLedgerEntryKind

  /// Атрибуция: покупка (Order), потребление (UsageEvent), comp-грант (админ) — все FK-less.
  orderId          String? @map("order_id") @db.Uuid
  usageEventId     String? @map("usage_event_id") @db.Uuid
  createdByAdminId String? @map("created_by_admin_id") @db.Uuid
  reason           String?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, createdAt])
  @@map("coin_ledger_entries")
}

/// Тип строки выручки (D-16/M-15).
enum RevenueType {
  PLAN_FEE
  COMMISSION
  COIN_PACK
  ADVERTISING
  REFUND
  ADJUSTMENT
}

/// Канал поступления (S-4 MANUAL в managed-фазе; провайдеры — по мере запуска).
enum RevenueChannel {
  MANUAL
  PAYME
  CLICK
  STRIPE
  VIA
}

/// Нормализованная строка выручки платформы (D-16, спецификация M-15).
/// НАМЕРЕННО без FK на Organization (паттерн AdminAuditLog): выручка переживает
/// hard-delete организации. amountMinor — знаковые тийины/центы (REFUND < 0).
/// Tenant-guard: документированное исключение — платформенные данные, читает
/// только супер-админ (S-10); в tenant-списки НЕ входит.
model RevenueEntry {
  id                String         @id @default(uuid()) @db.Uuid
  organizationRef   String         @map("organization_ref") @db.Uuid
  organizationLabel String?        @map("organization_label")
  type              RevenueType
  channel           RevenueChannel
  amountMinor       BigInt         @map("amount_minor")
  currency          Currency       @default(UZS)
  /// Ссылка на источник: orderId / providerTxnId / planPurchaseId.
  sourceRef         String?        @map("source_ref")
  occurredAt        DateTime       @default(now()) @map("occurred_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([organizationRef])
  @@index([type, occurredAt])
  @@index([channel, occurredAt])
  @@map("revenue_entries")
}

/// Платформенный key-value конфиг (D-17): персистентность для S-19 —
/// мастер-переключателя тарифной системы (BILLING_SWITCH_TOGGLE в аудите).
/// Глобальная модель (не tenant). Ключи — snake_case, значения — JSON.
model PlatformConfig {
  key              String   @id
  value            Json
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

/// Статус выплаты организатору (M-7).
enum PayoutStatus {
  PENDING
  PAID
}

/// Выплата организатору (M-7, мерчант-оф-рекорд по решению C-1): тело билетов
/// минус комиссия платформы. Managed-фаза — ручные выплаты по runbook
/// (docs/monetization/15-payout-runbook.md); автоматизация — P2 (M-7-auto).
model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  amountMinor    BigInt       @map("amount_minor")
  currency       Currency     @default(UZS)
  status         PayoutStatus @default(PENDING)
  /// Референс банковской платёжки выплаты (обязателен при PAID).
  externalRef    String?      @map("external_ref")
  /// FK-less SuperAdmin.id (прецедент archivedById).
  markedPaidById String?      @map("marked_paid_by_id") @db.Uuid
  markedPaidAt   DateTime?    @map("marked_paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("payouts")
}

/// Статус рекламного размещения (D-10/M-11).
enum AdOrderStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Рекламное размещение (D-10): фулфилмент featured-плейсмента и кампаний.
/// Создаётся оператором (S-11) при фулфилменте оплаченного ADVERTISING-заказа
/// или как $0 comp (грандфазер существующих featured — решение D-3 группы D).
/// placementEnd NULL = бессрочно (comp). Снятие по истечении — свип E-11b.
model AdOrder {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Оплаченный заказ-основание; NULL для comp-грандфазера.
  orderId        String?       @unique @map("order_id") @db.Uuid
  /// Продвигаемое событие (featured). Для email-кампаний может быть NULL.
  eventId        String?       @map("event_id") @db.Uuid
  skuCode        String        @map("sku_code")
  status         AdOrderStatus @default(ACTIVE)
  /// $0 comp-размещение (грандфазер/goodwill) — честный след в данных.
  isComp         Boolean       @default(false) @map("is_comp")

  placementStart DateTime  @default(now()) @map("placement_start")
  placementEnd   DateTime? @map("placement_end")

  createdByAdminId String?  @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status, placementEnd])
  @@map("ad_orders")
}

// ============================================================================
// СБОРКИ МОБИЛЬНОГО ПРИЛОЖЕНИЯ (внутренняя дистрибуция для команды).
// Файлы лежат в приватном сторадже (APP_BUILDS_DIR), доступ только SUPER_ADMIN.

enum AppBuildPlatform {
  ANDROID
  IOS
}

model AppBuild {
  id              String           @id @default(uuid()) @db.Uuid
  platform        AppBuildPlatform
  version         String // человекочитаемая версия, например "0.1.0 (42)"
  notes           String?
  originalName    String           @map("original_name")
  // Относительный путь внутри приватного стораджа (не публичный URL).
  storedPath      String           @map("stored_path")
  mimeType        String           @map("mime_type")
  size            Int
  uploadedById    String?          @map("uploaded_by_id") @db.Uuid
  uploadedByEmail String?          @map("uploaded_by_email")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([platform])
  @@index([createdAt])
  @@map("app_builds")
}

// Платформенные key-value настройки супер-админа (первый потребитель —
// пароль приватной инвесторской страницы). Значения не секретны в смысле
// криптографии: это управляемые из админки shared-секреты и флаги.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ============================================================================
// ПРОГРАММА УВЕДОМЛЕНИЙ (docs/notifications/DATA_MODEL_DELTA.md).
// Только аддитивные сущности: push-токены, преференсы, журнал доставок,
// планировщик и участнический in-app инбокс.

/// Push-токен устройства. Привязка к Account (единая identity), не к
/// User/OrganizationMember: устройство одно, workspace — атрибут сессии.
/// expoPushToken НЕ unique: один девайс с двумя аккаунтами даёт две строки —
/// прежнюю гасим по receipt'ам DeviceNotRegistered, не по constraint'у.
model DeviceToken {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  /// Клиентский uuid установки (SecureStore). Пара (account, installation) —
  /// identity устройства; expoPushToken — ротируемое значение.
  installationId String    @map("installation_id") @db.Uuid
  expoPushToken  String    @map("expo_push_token")
  platform       String // 'ios' | 'android'
  /// Локаль интерфейса на устройстве — ЕДИНСТВЕННЫЙ способ локализовать
  /// killed-push (сервер собирает текст пуша; см. audit/mobile.md).
  locale         String    @default("ru") // 'ru' | 'uz' | 'en'
  appVersion     String?   @map("app_version")
  osVersion      String?   @map("os_version")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  disabledAt     DateTime? @map("disabled_at")
  /// 'logout' | 'device_not_registered' — источник деактивации, для диагностики.
  disabledReason String?   @map("disabled_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, installationId]) // ключ PUT-upsert'а
  @@index([accountId, disabledAt]) // fan-out: активные токены аккаунта
  @@index([expoPushToken]) // обратный поиск по receipt'у DeviceNotRegistered
  @@index([lastSeenAt]) // stale-reaper (90д не шлём / 180д hard-cleanup строк)
  @@map("device_tokens")
}

/// Матрица преференсов. Строка существует только при отклонении от дефолта
/// (дефолты — в коде, GET мёржит). In-app канала в матрице нет намеренно:
/// лента дешёвая и не отключается. EmailUnsubscribe не трогается — законный
/// one-click механизм поверх матрицы (проверяются оба).
model NotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  /// PreferenceKey из CONTRACT_DIFF §2: event_reminders | saved_event_alerts |
  /// registration_status | summary | organizer_registrations | organizer_broadcast.
  /// String, не enum БД: добавление ключа не требует миграции (валидация в DTO).
  key       String
  push      Boolean  @default(true)
  email     Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@map("notification_preferences")
}

/// Журнал доставок + замок идемпотентности. FK намеренно не объявляются
/// (только uuid-колонки + индексы): журнал должен переживать удаление
/// событий/регистраций — Cascade стёр бы историю доставок.
model NotificationDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  /// Ключ идемпотентности (форматы — в NOTIFICATIONS_CATALOG). Уникален в
  /// связке (dedupKey, accountId, channel) — решение BL-01: один логический
  /// ключ порождает по строке на получателя и канал; рестарт воркера/двойной
  /// вызов → P2002 → noop.
  dedupKey       String    @map("dedup_key")
  /// ID из NOTIFICATIONS_CATALOG (напр. 'REM-01') — связь доставки с каталогом.
  catalogId      String    @map("catalog_id")
  channel        String // 'push' | 'email' | 'in_app'
  /// Получатель: ровно одно из двух заполнено.
  accountId      String?   @map("account_id") @db.Uuid
  /// Для организаторских in-app без персональной адресации — организация.
  organizationId String?   @map("organization_id") @db.Uuid
  /// Денормализованные ссылки для каскадной инвалидации и диагностики.
  eventId        String?   @map("event_id") @db.Uuid
  registrationId String?   @map("registration_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  status         String    @default("enqueued")
  // 'scheduled' | 'enqueued' | 'sent' | 'delivered' | 'failed' | 'cancelled'
  // | 'skipped' | 'suppressed_rate_limit' | 'suppressed_preference' | 'suppressed_unsubscribe'
  /// Снапшот аргументов шаблона (payload пуша) — для ресенда и разбора инцидентов.
  payload        Json?
  error          String?   @db.Text
  /// Expo push ticket id — для сверки receipts.
  providerRef    String?   @map("provider_ref")
  scheduledFor   DateTime? @map("scheduled_for")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([dedupKey, accountId, channel])
  @@index([accountId, createdAt])
  @@index([eventId])
  @@index([registrationId])
  @@index([status, createdAt]) // reaper «застрявших enqueued» + failed-мониторинг
  @@index([catalogId, createdAt]) // аналитика по типам
  @@map("notification_deliveries")
}

/// Плановые уведомления: источник истины — БД, не Redis (flush BullMQ не
/// должен терять напоминания). Repeatable-воркер выбирает due-строки
/// (SELECT … FOR UPDATE SKIP LOCKED), прогоняет guard и создаёт
/// NotificationDelivery + канальные job'ы. FK не объявляются — как у Delivery.
model ScheduledNotification {
  id             String    @id @default(uuid()) @db.Uuid
  catalogId      String    @map("catalog_id") // 'REM-01', 'CLS-01', 'SUM-02', 'MOD-03', 'REG-03'…
  /// Совпадает с будущим dedupKey доставки — планировщик идемпотентен:
  /// повторное планирование того же ключа → upsert-noop.
  dedupKey       String    @unique @map("dedup_key")
  runAt          DateTime  @map("run_at") // UTC-момент; TZ-математика — при планировании
  status         String    @default("scheduled") // 'scheduled' | 'dispatched' | 'cancelled' | 'skipped'
  /// Каскадная инвалидация (инвариант №3): cancelBy({eventId|registrationId|orderId}).
  eventId        String?   @map("event_id") @db.Uuid
  registrationId String?   @map("registration_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  accountId      String?   @map("account_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  /// Контекст для guard-проверки и построения текста в момент исполнения
  /// (например eventVersion, offsetKey, threshold).
  context        Json?
  cancelledAt    DateTime? @map("cancelled_at")
  cancelReason   String?   @map("cancel_reason")
  dispatchedAt   DateTime? @map("dispatched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt]) // тик планировщика: WHERE status='scheduled' AND run_at <= now()
  @@index([eventId, status]) // каскадная отмена по событию
  @@index([registrationId, status]) // …по регистрации
  @@index([orderId, status]) // …по заказу (payment-цепочка)
  @@map("scheduled_notifications")
}

/// Участнический in-app инбокс. Отдельная таблица, а не расширение
/// Notification: у того organizationId NOT NULL + Cascade FK — участнику
/// организация не нужна, а снятие constraint'а не аддитивно. Та же философия:
/// type+payload, никаких готовых фраз; персональный readAt с рождения.
model AccountNotification {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  /// AccountNotificationType из CONTRACT_DIFF §5. String в БД (не enum) —
  /// добавление типа без миграции; контрактная валидация в DTO.
  type       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  /// Подстановки для локализованной строки. Никаких готовых фраз (принцип Notification).
  payload    Json?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt]) // лента
  @@index([accountId, readAt]) // unread-count
  @@map("account_notifications")
}

/// Short-lived, single-use bridge for native OAuth. Bearer tokens are never
/// placed in a redirect URL and are encrypted at rest until atomic exchange.
model MobileOAuthExchange {
  id         String   @id @default(uuid()) @db.Uuid
  codeHash   String   @unique @map("code_hash")
  ciphertext String   @db.Text
  iv         String
  authTag    String   @map("auth_tag")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("mobile_oauth_exchanges")
}
