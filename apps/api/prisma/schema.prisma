}

// ==================== EVENT COLLECTION (Подборки событий) ====================

model EventCollection {
  id              String  @id @default(uuid()) @db.Uuid
  title           String
  slug            String  @unique
  coverImage      String? @map("cover_image") // URL изображения обложки
  gradientStart   String? @map("gradient_start") // Цвет начала градиента (HEX)
  gradientEnd     String? @map("gradient_end") // Цвет конца градиента (HEX)
  description     String? @db.Text
  translations    Json    @default("{}")
  translationMeta Json    @default("{}") @map("translation_meta")
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")

