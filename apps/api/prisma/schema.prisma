// ==================== REGISTRATION FILE UPLOAD ====================

// Файл, загруженный участником в ответ на вопрос типа FILE_UPLOAD.
// Хранится в приватной директории (НЕ в публичном /uploads), отдаётся
// только через авторизованный download-эндпоинт с проверкой tenant-доступа.
model RegistrationFileUpload {
  id             String                 @id @default(uuid()) @db.Uuid
  eventId        String                 @map("event_id") @db.Uuid
  questionId     String                 @map("question_id") @db.Uuid
  // null до сабмита (файл загружен, но регистрация ещё не создана).
  registrationId String?                @map("registration_id") @db.Uuid
  // Снимок tenant-владельца события — денормализован для tenant-isolation.
  organizationId String                 @map("organization_id") @db.Uuid
  // Пользователь, загрузивший файл (для проверки владения PENDING-файлами).
  uploadedById   String?                @map("uploaded_by_id") @db.Uuid
  originalName   String                 @map("original_name")
  // Относительный путь внутри приватного стораджа (не публичный URL).
  storedPath     String                 @map("stored_path")
  mimeType       String                 @map("mime_type")
  size           Int
  status         RegistrationFileStatus @default(PENDING)
  createdAt      DateTime               @default(now()) @map("created_at")

  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question     RegistrationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  registration Registration?        @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([questionId])
  @@index([registrationId])
  @@index([uploadedById])
  // Tenant-isolation scans on the denormalized organization snapshot.
  @@index([organizationId])
  @@map("registration_file_uploads")
}

// ==================== ATTENDANCE ====================

/**
 * Промежуточный чекпоинт события: именованное окно времени, внутри которого
 * участника отмечают ровно один раз («Регистрация», «Обед», «День 2 — вход»).
 * Окна одного события не пересекаются (валидация в EventCheckpointsService),
 * поэтому в любой момент активен максимум один чекпоинт. Окно полуоткрытое:
 * [startsAt, endsAt) — соседние чекпоинты могут стыковаться встык.
 */
model EventCheckpoint {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([eventId, startsAt])
  @@map("event_checkpoints")
}

/**
 * Уникальность отметки задана двумя ЧАСТИЧНЫМИ индексами (Prisma их не умеет,
 * см. migration 20260811120000_add_event_checkpoints):
 * - (registration_id, check_in_date) WHERE checkpoint_id IS NULL  — старое
 * правило «один check-in на UTC-день», когда активного чекпоинта нет;
 * - (registration_id, checkpoint_id) WHERE checkpoint_id IS NOT NULL — один
 * check-in на чекпоинт.
 * Поэтому дедуп в сервисах — findFirst + перехват P2002, а не findUnique.
 */
model Attendance {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  checkpointId   String?  @map("checkpoint_id") @db.Uuid
  checkInAt      DateTime @map("check_in_at")
  checkInDate    DateTime @map("check_in_date") @db.Date // Дата для группировки по дням
  createdAt      DateTime @default(now()) @map("created_at")

  registration Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkpoint   EventCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([checkInDate])
  @@index([checkpointId])
  @@map("attendances")
}

