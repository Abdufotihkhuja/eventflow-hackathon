  // userId остаётся nullable (но в новых записях один из двух обязателен).
  userId               String? @map("user_id") @db.Uuid
  authorOrganizationId String? @map("author_organization_id") @db.Uuid
  parentId             String? @map("parent_id") @db.Uuid // Для ответов на комментарии

