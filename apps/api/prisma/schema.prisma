  USD
  EUR
  UZS
}

enum RentalPlaceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VerificationCodeType {
  EMAIL_VERIFICATION // Подтверждение email
  PASSWORD_RESET // Сброс пароля
  EMAIL_CHANGE // Смена email
}

enum ContactRequestStatus {
  NEW // Новая заявка
  IN_PROGRESS // В работе
