datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==================== ENUMS ====================

enum AuthProvider {
  EMAIL
  GOOGLE
  LINKEDIN
}

enum ActorKind {
  USER
  ORGANIZATION
  MEMBER
  SUPER_ADMIN
}

enum UserType {
  USER
  ORGANIZATION
  MEMBER
  SUPER_ADMIN
}

enum MembershipKind {
  OWNER
  MEMBER
}

enum PlatformRole {
  SUPER_ADMIN
}

enum PlatformElevationMode {
  READ
  WRITE
}

enum MemberStatus {
  ACTIVE // Активен
  SUSPENDED // Приостановлен
  INVITED // Приглашён (ожидает активации)
}

enum InviteStatus {
  PENDING // Ожидает принятия
  ACCEPTED // Принято — членство создано
  EXPIRED // Истёк срок действия
  REVOKED // Отозвано администратором
  DECLINED // Приглашённый отказался (может оставить комментарий)
}

enum EventType {
  FREE // Бесплатный
  PAID // Платный
}

enum EventAccessType {
  OPEN // Открытая регистрация (все могут зарегистрироваться)
  REQUEST // По запросу (требуется одобрение организатора)
  INVITE_ONLY // Только по приглашению (по ссылке/коду)
  PRIVATE // Приватное событие, не показывается публично и не допускает внешнюю регистрацию
}

enum EventFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW // На модерации у супер-админа
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrganizationVerificationStatus {
  PENDING // Ожидает проверки
  APPROVED // Одобрена
  REJECTED // Отклонена
}

enum AgendaItemType {
  KEYNOTE // Основной доклад
  PRESENTATION // Презентация
  WORKSHOP // Воркшоп
  PANEL // Панельная дискуссия
  NETWORKING // Нетворкинг
  BREAK // Перерыв
  OPENING // Открытие
  CLOSING // Закрытие
  REGISTRATION // Регистрация
  MENTORSHIP // Работа с менторами
  MENTOR_SESSION // Менторские сессии
  FREE_WORK // Свободная работа
}

enum QuestionType {
  TEXT
  NUMBER
  SELECT
  CHECKBOX
  TEXTAREA
  FILE_UPLOAD // Загрузка файла(ов) участником
}

// Статус файла, загруженного участником в ответ на вопрос FILE_UPLOAD.
// PENDING  — файл загружен до сабмита регистрации (ещё не привязан).
// ATTACHED — файл закреплён за конкретной регистрацией после сабмита.
enum RegistrationFileStatus {
  PENDING
  ATTACHED
}

enum QuestionCategory {
  OPEN // Открытый - развернутый ответ
  CLOSED // Закрытый - да/нет
  ALTERNATIVE // Альтернативный - выбор из вариантов
  RHETORICAL // Риторический - информационный текст
}

enum RegistrationMode {
  QUESTIONS // Уточняющие вопросы
  TEST // Тестирование
}

enum TestEvaluationType {
  AUTO_REJECT // Автоматический отбор (не прошел = отклонен)
  EVALUATION // Для оценки (все допускаются, но видны результаты)
}

enum RegistrationStatus {
  PENDING // Ожидает подтверждения
  APPROVED // Одобрена
  REJECTED // Отклонена
  CANCELLED // Отменена
}

enum AssetGenerationStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum TicketArtifactDesign {
  BRANDED
  SIMPLE
}

enum ParticipantRole {
  PARTICIPANT // Участник
  SPEAKER // Выступаю/веду
