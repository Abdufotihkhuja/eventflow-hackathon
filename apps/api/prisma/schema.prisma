  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Данные статьи (сохраняются при добавлении в избранное)
  articleUrl String  @map("article_url") // Ссылка на оригинальную статью
  title      String // Заголовок статьи
  excerpt    String? @db.Text // Краткое описание
  coverImage String? @map("cover_image") // Изображение обложки
  category   String? // Категория (TIPS-GUIDES, EVENT-MARKETING, NEWS-TRENDS)

  // Метаданные статьи
  publishedAt DateTime? @map("published_at") // Дата публикации статьи
  readingTime Int?      @map("reading_time") // Время чтения в минутах
  authorName  String?   @map("author_name") // Автор статьи

  savedAt DateTime @default(now()) @map("saved_at") // Когда сохранена

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleUrl]) // Нельзя сохранить одну статью дважды
  @@index([userId])
  @@index([savedAt])
  @@map("saved_articles")
}

// ==================== USER FOLLOWING (Подписки пользователей на организаторов) ====================

model UserFollowing {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_followings")
}

// ==================== CONTACT REQUEST (Заявки на связь с организатором) ====================

model ContactRequest {
  id                      String               @id @default(uuid()) @db.Uuid
  userId                  String?              @map("user_id") @db.Uuid
  organizationId          String               @map("organization_id") @db.Uuid
  requesterOrganizationId String?              @map("requester_organization_id") @db.Uuid
  rentalPlaceId           String?              @map("rental_place_id") @db.Uuid
  type                    ContactRequestType   @default(GENERAL)
  rentalType              RentalType?          @map("rental_type")
  phone                   String
  message                 String?              @db.Text
  status                  ContactRequestStatus @default(NEW)
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  user                  User?         @relation("UserContactRequests", fields: [userId], references: [id], onDelete: SetNull)
  organization          Organization  @relation("OrganizationContactRequests", fields: [organizationId], references: [id], onDelete: Cascade)
  requesterOrganization Organization? @relation("RequesterOrganizationContactRequests", fields: [requesterOrganizationId], references: [id], onDelete: SetNull)
  rentalPlace           RentalPlace?  @relation(fields: [rentalPlaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([requesterOrganizationId])
  @@index([rentalPlaceId])
  @@map("contact_requests")
}

// ==================== BOARD (Доска задач) ====================

model Board {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  eventId         String?  @map("event_id") @db.Uuid
  name            String
  description     String?  @db.Text
  coverImage      String?  @map("cover_image")
  backgroundColor String?  @map("background_color")
  settings        Json?    @default("{}") // Кастомизация: тема, цвета карточек и т.д.
  isFavorite      Boolean  @default(false) @map("is_favorite")
  isArchived      Boolean  @default(false) @map("is_archived")
  createdById     String?  @map("created_by_id") @db.Uuid // Nullable для создания организацией
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    OrganizationMember? @relation("BoardCreator", fields: [createdById], references: [id])
  columns      BoardColumn[]
  tasks        BoardTask[]
  tags         BoardTag[]
  members      BoardMember[]

  @@index([organizationId])
  @@index([eventId])
  @@index([isArchived])
  @@map("boards")
}

// ==================== BOARD COLUMN (Колонка доски) ====================

model BoardColumn {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  color     String? // HEX цвет колонки
  position  Int      @default(0)
  wipLimit  Int?     @map("wip_limit") // Work In Progress лимит
  isDefault Boolean  @default(false) @map("is_default") // Колонка "Готово"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks BoardTask[]

  @@index([boardId])
  @@map("board_columns")
}

// ==================== BOARD TASK (Задача) ====================

model BoardTask {
  id             String       @id @default(uuid()) @db.Uuid
  boardId        String       @map("board_id") @db.Uuid
  columnId       String       @map("column_id") @db.Uuid
  title          String
  description    String?      @db.Text
  type           TaskType     @default(TASK)
  priority       TaskPriority @default(MEDIUM)
  position       Int          @default(0)
  dueDate        DateTime?    @map("due_date")
  startDate      DateTime?    @map("start_date")
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(6, 2)
  loggedHours    Decimal?     @default(0) @map("logged_hours") @db.Decimal(6, 2)
  coverImage     String?      @map("cover_image")
  coverColor     String?      @map("cover_color")
  isCompleted    Boolean      @default(false) @map("is_completed")
  completedAt    DateTime?    @map("completed_at")
  createdById    String?      @map("created_by_id") @db.Uuid // Nullable для организации
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  board       Board                 @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      BoardColumn           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignees   BoardTaskAssignee[]
  tags        BoardTaskTag[]
  comments    BoardTaskComment[]
  attachments BoardTaskAttachment[]
  checklists  BoardTaskChecklist[]
  activities  BoardTaskActivity[]

  @@index([boardId])
  @@index([columnId])
  @@index([isCompleted])
  @@index([dueDate])
  @@map("board_tasks")
}

// ==================== BOARD TAG (Тег доски) ====================

model BoardTag {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  color     String // HEX цвет тега
  createdAt DateTime @default(now()) @map("created_at")

  board Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks BoardTaskTag[]

  @@unique([boardId, name])
  @@index([boardId])
  @@map("board_tags")
}

// ==================== BOARD TASK TAG (Связь задача-тег) ====================

model BoardTaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  task BoardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  BoardTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("board_task_tags")
}

// ==================== BOARD TASK ASSIGNEE (Исполнители задачи) ====================

model BoardTaskAssignee {
  taskId       String   @map("task_id") @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by_id") @db.Uuid // Nullable для организации

  task       BoardTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member     OrganizationMember  @relation("TaskAssignee", fields: [memberId], references: [id], onDelete: Cascade)
  assignedBy OrganizationMember? @relation("TaskAssignedBy", fields: [assignedById], references: [id])

  @@id([taskId, memberId])
  @@map("board_task_assignees")
}

// ==================== BOARD TASK COMMENT (Комментарий к задаче) ====================

model BoardTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  memberId  String?  @map("member_id") @db.Uuid // Nullable для организации
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   BoardTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member OrganizationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("board_task_comments")
}

// ==================== BOARD TASK ATTACHMENT (Вложение к задаче) ====================

model BoardTaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  fileSize     Int      @map("file_size") // Размер в байтах
  mimeType     String   @map("mime_type")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid // Nullable для организации
  createdAt    DateTime @default(now()) @map("created_at")

  task       BoardTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy OrganizationMember? @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("board_task_attachments")
}

// ==================== BOARD TASK CHECKLIST (Чеклист задачи) ====================

model BoardTaskChecklist {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task  BoardTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items BoardChecklistItem[]

  @@index([taskId])
  @@map("board_task_checklists")
}

// ==================== BOARD CHECKLIST ITEM (Пункт чеклиста) ====================

model BoardChecklistItem {
  id            String    @id @default(uuid()) @db.Uuid
  checklistId   String    @map("checklist_id") @db.Uuid
  title         String
  isCompleted   Boolean   @default(false) @map("is_completed")
  position      Int       @default(0)
  completedAt   DateTime? @map("completed_at")
  completedById String?   @map("completed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  checklist   BoardTaskChecklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy OrganizationMember? @relation(fields: [completedById], references: [id])

  @@index([checklistId])
  @@map("board_checklist_items")
}

// ==================== BOARD TASK ACTIVITY (История изменений задачи) ====================

model BoardTaskActivity {
  id        String       @id @default(uuid()) @db.Uuid
  taskId    String       @map("task_id") @db.Uuid
  memberId  String?      @map("member_id") @db.Uuid // Nullable для организации
  type      ActivityType
  details   Json? // Детали изменения: { field: "title", oldValue: "...", newValue: "..." }
  createdAt DateTime     @default(now()) @map("created_at")

  task   BoardTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member OrganizationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
  @@map("board_task_activities")
}

// ==================== BOARD MEMBER (Участник доски) ====================

model BoardMember {
  boardId   String    @map("board_id") @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  role      BoardRole @default(MEMBER)
  addedAt   DateTime  @default(now()) @map("added_at")
  addedById String?   @map("added_by_id") @db.Uuid // Nullable для организации

  board   Board               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  member  OrganizationMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  addedBy OrganizationMember? @relation("BoardMemberAddedBy", fields: [addedById], references: [id])

  @@id([boardId, memberId])
  @@map("board_members")
}

// ==================== EMAIL VERIFICATION CODE ====================

model EmailVerificationCode {
  id        String               @id @default(uuid()) @db.Uuid
  code      String // 6-значный код
  email     String // Email получателя
  type      VerificationCodeType // EMAIL_VERIFICATION, PASSWORD_RESET, EMAIL_CHANGE
  actorType UserType             @map("actor_type") // USER, ORGANIZATION, MEMBER
  actorId   String?              @map("actor_id") @db.Uuid // ID actor (nullable для разных типов)

  // Для смены email
  newEmail String? // Новый email (для type = EMAIL_CHANGE)

  // Статусы
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at") // Истекает через 5 минут
  attempts  Int       @default(0) // Количество попыток проверки

  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, type, isUsed])
  @@index([code, expiresAt])
  @@index([actorId])
  @@map("email_verification_codes")
}

// ==================== BLOG POST (Статья блога) ====================

model BlogPost {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  // Optional byline author — points to an OrganizationMember (org staff,
  // not a platform-wide User account). When set, the public site emits
  // `BlogPosting.author = Person` (name/avatar/bio from the member) for
  // E-E-A-T. When null, falls back to `author = Organization`. SetNull on
  // delete so removing a member doesn't take down their published posts.
  authorId            String?        @map("author_id") @db.Uuid
  title               String
  slug                String         @unique
  content             Json // BlockNote document
  shortDescription    String?        @map("short_description") @db.VarChar(500)
  translations        Json           @default("{}")
  translationMeta     Json           @default("{}") @map("translation_meta")
  richTranslations    Json           @default("{}") @map("rich_translations")
  richTranslationMeta Json           @default("{}") @map("rich_translation_meta")
  coverImage          String?        @map("cover_image")
  categoryId          String?        @map("category_id") @db.Uuid
  status              BlogPostStatus @default(DRAFT)
  commentsEnabled     Boolean        @default(true) @map("comments_enabled")
  readingTime         Int            @default(0) @map("reading_time") // минуты

  // Модерация
  rejectionMessage String?   @map("rejection_message") @db.Text
  reviewedAt       DateTime? @map("reviewed_at")
  publishedAt      DateTime? @map("published_at")

  // Счётчики (денормализация для производительности)
  likesCount    Int @default(0) @map("likes_count")
  commentsCount Int @default(0) @map("comments_count")
  viewsCount    Int @default(0) @map("views_count")

  // Удаление супер-админом (soft delete)
  deletedAt             DateTime? @map("deleted_at")
  deletedBySuperAdminId String?   @map("deleted_by_super_admin_id") @db.Uuid
  deletionReason        String?   @map("deletion_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            BlogCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author              OrganizationMember?     @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  deletedBySuperAdmin SuperAdmin?             @relation(fields: [deletedBySuperAdminId], references: [id], onDelete: SetNull)
  tags                BlogPostTagAssignment[]
  comments            BlogPostComment[]
  likes               BlogPostLike[]
  savedBy             SavedBlogPost[]

  @@index([organizationId])
  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@index([slug])
  @@index([categoryId])
  @@map("blog_posts")
}

// ==================== BLOG CATEGORY (Категории блога) ====================

model BlogCategory {
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @unique
  slug            String  @unique
  description     String? @db.Text
  translations    Json    @default("{}")
  translationMeta Json    @default("{}") @map("translation_meta")
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts BlogPost[]

  @@index([isActive, sortOrder])
  @@map("blog_categories")
}

// ==================== BLOG POST LIKE (Лайки статей) ====================

model BlogPostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("blog_post_likes")
}

// ==================== BLOG POST COMMENT (Комментарии к статье) ====================

model BlogPostComment {
  id       String  @id @default(uuid()) @db.Uuid
  postId   String  @map("post_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  content  String  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post    BlogPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  BlogPostComment?      @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogPostComment[]     @relation("BlogCommentReplies")
  likes   BlogPostCommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("blog_post_comments")
}

// ==================== BLOG POST COMMENT LIKE (Лайки/дизлайки комментариев) ====================

model BlogPostCommentLike {
  commentId String  @map("comment_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  isLike    Boolean @map("is_like") // true = лайк, false = дизлайк

  createdAt DateTime @default(now()) @map("created_at")

  comment BlogPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("blog_post_comment_likes")
}

// ==================== SAVED BLOG POST (Сохранённые статьи блога) ====================

model SavedBlogPost {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  postId  String   @map("post_id") @db.Uuid
  savedAt DateTime @default(now()) @map("saved_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([savedAt])
  @@map("saved_blog_posts")
}

// ==================== BLOG POST TAG ASSIGNMENT (Связь статья-теги) ====================

model BlogPostTagAssignment {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  EventTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([postId])
  @@index([tagId])
  @@map("blog_post_tag_assignments")
}

// ==================== EVENT CATEGORY (Категории событий) ====================

model EventCategory {
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @unique
  slug            String  @unique
  icon            String? // Название иконки (например: "book", "users", "mic")
  description     String? @db.Text
  translations    Json    @default("{}")
  translationMeta Json    @default("{}") @map("translation_meta")
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events Event[] @relation("EventCategories")

  @@index([isActive, sortOrder])
