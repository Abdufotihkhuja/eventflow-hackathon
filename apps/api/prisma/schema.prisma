// ==================== USER ====================

model Account {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  phone       String?
  /// Локаль интерфейса ('ru'|'uz'|'en'). NULL = 'ru' (текущее де-факто поведение писем).
  /// Заполняется при логине/смене языка. Использование: locale писем и fallback
  /// для пушей без DeviceToken.locale (DATA_MODEL_DELTA §6).
  locale      String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  identities              Identity[]
  memberships             Membership[]
  platformAdminGrants     PlatformAdminGrant[]
  platformElevations      PlatformElevation[]
  refreshTokens           RefreshToken[]
  deviceTokens            DeviceToken[]
  notificationPreferences NotificationPreference[]
  accountNotifications    AccountNotification[]

  @@index([email])
  @@map("accounts")
}

model PlatformElevation {
  id                 String                @id @default(uuid()) @db.Uuid
  accountId          String                @map("account_id") @db.Uuid
  requestedByAdminId String                @map("requested_by_admin_id") @db.Uuid
  approvedByAdminId  String?               @map("approved_by_admin_id") @db.Uuid
  organizationId     String?               @map("organization_id") @db.Uuid
  mode               PlatformElevationMode @default(READ)
  tokenHash          String?               @unique @map("token_hash")
  reason             String
  expiresAt          DateTime              @map("expires_at")
  revokedAt          DateTime?             @map("revoked_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  approvedAt         DateTime?             @map("approved_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@index([organizationId])
  @@map("platform_elevations")
}

model Identity {
  id           String       @id @default(uuid()) @db.Uuid
  accountId    String       @map("account_id") @db.Uuid
  provider     AuthProvider
  email        String
  providerId   String?      @map("provider_id")
  passwordHash String?      @map("password_hash")
  actorType    UserType     @map("actor_type")
  actorId      String       @map("actor_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([actorType, actorId])
  @@index([accountId])
  @@index([email])
  @@map("identities")
}

model Membership {
  id                   String         @id @default(uuid()) @db.Uuid
  accountId            String         @map("account_id") @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  organizationMemberId String?        @map("organization_member_id") @db.Uuid
  /// Canonical role projection. The composite relation makes a cross-tenant
  /// role reference impossible at the database boundary. Nullable during the
  /// additive backfill/dual-read window.
  roleId               String?        @map("role_id") @db.Uuid
  kind                 MembershipKind
  roleName             String?        @map("role_name")
  permissions          String[]       @default([])
  hiddenAt             DateTime?      @map("hidden_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember? @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  role               OrganizationRole?   @relation("MembershipRole", fields: [organizationId, roleId], references: [organizationId, id])

  @@unique([accountId, organizationId, kind])
  @@unique([organizationMemberId])
  @@index([accountId])
  @@index([organizationId])
  @@index([organizationId, roleId])
  @@map("memberships")
}

model PlatformAdminGrant {
  id           String       @id @default(uuid()) @db.Uuid
  accountId    String       @map("account_id") @db.Uuid
  superAdminId String       @map("super_admin_id") @db.Uuid
  role         PlatformRole @default(SUPER_ADMIN)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@unique([accountId, superAdminId])
  @@index([accountId])
  @@index([superAdminId])
  @@map("platform_admin_grants")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  passwordHash    String?      @map("password_hash")
  firstName       String?      @map("first_name")
  lastName        String?      @map("last_name")
  avatarUrl       String?      @map("avatar_url")
  phone           String?
  location        String?
  bio             String?      @db.Text
  authProvider    AuthProvider @default(EMAIL) @map("auth_provider")
  providerId      String?      @map("provider_id")
  isEmailVerified Boolean      @default(false) @map("is_email_verified")

  // Настройки приватности
  isPublicProfile Boolean @default(true) @map("is_public_profile") // Публичный профиль
  showEmail       Boolean @default(false) @map("show_email") // Показывать email другим пользователям
  showPhone       Boolean @default(false) @map("show_phone") // Показывать телефон другим пользователям

  // Онбординг
  isOnboardingCompleted Boolean @default(false) @map("is_onboarding_completed") // Завершен ли онбординг

  // Доп. поля профиля (popup «Заполните доп. поля» для пользователя)
  gender               Gender? // Муж/Жен
  dateOfBirth          DateTime?          @map("date_of_birth") @db.Date
  region               String?            @db.VarChar(150) // Регион Узбекистана
  languages            String[]           @default([]) // Языки (несколько)
  profileStatus        UserProfileStatus? @map("profile_status") // Работник/школьник/студент
  workOrStudyPlace     String?            @map("work_or_study_place") @db.VarChar(500) // Где работает или учится
  skills               String[]           @default([]) // Навыки: макс. 3 из списка
  specialization       Specialization? // Одна из: Юрист, программист, ...
  shortBio             String?            @map("short_bio") @db.VarChar(150) // Коротко о себе (150 символов)
  profileInfoCompleted Boolean            @default(false) @map("profile_info_completed") // Popup не показывать

  // Соцсети и ссылки (опционально)
  linkedinUrl  String? @map("linkedin_url")
  instagramUrl String? @map("instagram_url")
  facebookUrl  String? @map("facebook_url")
  websiteUrl   String? @map("website_url")

  // Архивация (soft delete) супер-админом. deletedAt — момент архивации.
  deletedAt     DateTime? @map("deleted_at")
  archivedById  String?   @map("archived_by_id") @db.Uuid // SuperAdmin.id, кто архивировал
  archiveReason String?   @map("archive_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  registrations          Registration[]
  userCertificates       UserCertificate[]
  savedArticles          SavedArticle[]
  speakers               Speaker[]
  eventComments          EventComment[]
  commentLikes           EventCommentLike[]
  savedEvents            SavedEvent[]
  followingOrganizations UserFollowing[]
  contactRequests        ContactRequest[]   @relation("UserContactRequests")
  eventRecipients        EventRecipient[]

  // Blog relations
  blogPostLikes        BlogPostLike[]
  blogPostComments     BlogPostComment[]
  blogPostCommentLikes BlogPostCommentLike[]
  savedBlogPosts       SavedBlogPost[]

  organizationInvites OrganizationInvite[]

  @@map("users")
}

// ==================== ORGANIZATION ====================

model Organization {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  passwordHash    String?      @map("password_hash")
  name            String
  companyName     String       @map("company_name")
  translations    Json         @default("{}")
  translationMeta Json         @default("{}") @map("translation_meta")
  inn             String?      @unique // ИНН организации (для входа сотрудников)
  description     String?      @db.Text
  phone           String?
  address         String? // Адрес организации
  website         String? // Веб-сайт организации
  logoUrl         String?      @map("logo_url")
  authProvider    AuthProvider @default(EMAIL) @map("auth_provider")
  providerId      String?      @map("provider_id")
  isEmailVerified Boolean      @default(false) @map("is_email_verified")

  // Верификация организации супер-админом
  verificationStatus OrganizationVerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?                        @map("rejection_reason") @db.Text
  verifiedAt         DateTime?                      @map("verified_at")

  // Онбординг
  isOnboardingCompleted Boolean @default(false) @map("is_onboarding_completed") // Завершен ли онбординг

  // Доп. поля компании (popup «Заполните доп. поля» — только для организатора, не для сотрудников)
  industry             String? @db.VarChar(100) // Отрасль
  companySize          Int?    @map("company_size") // Размер компании (число сотрудников)
  companyInfoCompleted Boolean @default(false) @map("company_info_completed") // Доп. поля заполнены — popup не показывать
  placesFeatureEnabled Boolean @default(false) @map("places_feature_enabled") // Доступна ли витрина арендуемых площадок

  // Брендинг билетов (hex #RRGGBB). Используются на билете и в email-шаблонах.
  brandColor  String? @map("brand_color")
  accentColor String? @map("accent_color")

  // Архивация (soft delete) супер-админом. deletedAt — момент архивации.
  deletedAt     DateTime? @map("deleted_at")
  archivedById  String?   @map("archived_by_id") @db.Uuid // SuperAdmin.id, кто архивировал
  archiveReason String?   @map("archive_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  members               OrganizationMember[]
  memberships           Membership[]
  invites               OrganizationInvite[]
  roles                 OrganizationRole[]
  events                Event[]
  boards                Board[]
  followers             UserFollowing[]
  contactRequests       ContactRequest[]     @relation("OrganizationContactRequests")
  customTags            EventTag[]
  blogPosts             BlogPost[]
  rentalPlaces          RentalPlace[]
  sentContactRequests   ContactRequest[]     @relation("RequesterOrganizationContactRequests")
  authoredEventComments EventComment[]       @relation("OrganizationEventComments")

  // Приостановка платформенными операторами (D-17/S-8/E-17; решение D-1 группы D).
  // FK-less suspendedById (SuperAdmin.id) — прецедент archivedById.
  suspendedAt     DateTime? @map("suspended_at")
  suspendedById   String?   @map("suspended_by_id") @db.Uuid
  suspendedReason String?   @map("suspended_reason")

  // Монетизация (D-9, D-5)
  billingOrders         Order[]
  planPurchases         PlanPurchase[]
  creditConsumptions    EventCreditConsumption[]
  planCreditAdjustments PlanCreditAdjustment[]
  entitlementOverrides  EntitlementOverride[]
  accessOverrides       OrganizationAccessOverride[]
  payouts               Payout[]
  adOrders              AdOrder[]
  usageEvents           UsageEvent[]
  usageCounters         UsageCounter[]
  coinLedgerEntries     CoinLedgerEntry[]
  notifications         Notification[]

  @@index([verificationStatus])
  @@map("organizations")
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  REGISTRATION_CREATED // Новая заявка на событие организации
  REGISTRATION_APPROVED // Заявка одобрена
  REGISTRATION_REJECTED // Заявка отклонена
  EVENT_PUBLISHED // Событие прошло модерацию
  EVENT_REJECTED // Событие отклонено модерацией
  MEMBER_JOINED // Сотрудник принял приглашение
  ORG_VERIFIED // Организация подтверждена
  ORG_VERIFICATION_REJECTED // Верификация организации отклонена
  // --- Программа уведомлений (docs/notifications, CONTRACT_DIFF §5) ---
  EVENT_SUBMITTED // MOD-01: событие подано на модерацию
  EVENT_CHANGES_REQUESTED // MOD-04 kind=changes_requested (EVENT_REJECTED остаётся для kind=rejected)
  REGISTRATION_FIRST // REG-20: первая регистрация на событие
  CAPACITY_THRESHOLD // REG-21: заполненность (payload {threshold: 50|80|100})
  TICKET_REFUND // REG-23: возврат билета
  REGISTRATION_CLOSED // CLS-03/CLS-04: регистрация закрыта (payload с итогами)
  EVENT_SUMMARY // SUM-02: итоги события
  MEMBER_INVITE_DECLINED // Приглашённый отказался вступить в команду (payload: personName, roleName, reason?)
}

/// Уведомление в центре уведомлений организации.
///
/// Хранит ТИП и структурированный payload, а НЕ готовую фразу. Лента активности
/// на дашборде складывает description вида «+1 регистрация на …» прямо в БД —
/// из-за этого мобильный клиент вынужден её выбрасывать и пересобирать текст
/// заново, иначе узбекский и английский интерфейс показывают русский. Здесь
/// фразу собирает клиент из type + payload, на своём языке.
model Notification {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// Адресат. null = уведомление всей организации: его видит любой сотрудник.
  memberId       String? @map("member_id") @db.Uuid

  type NotificationType

  /// На что ссылается уведомление — чтобы открыть нужный экран по тапу.
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  /// Подстановки для локализованной строки (название события, имя человека).
  /// Никаких готовых предложений.
  payload Json?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       OrganizationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Лента читается «свежие сверху»; счётчик непрочитанных — тем же ключом.
  @@index([organizationId, createdAt])
  @@index([organizationId, readAt])
  @@map("notifications")
}

// ==================== ORGANIZATION MEMBER ====================

model OrganizationMember {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  email          String
  passwordHash   String? @map("password_hash")
  firstName      String  @map("first_name")
  lastName       String  @map("last_name")
  phone          String?
  position       String?
  department     String?
  avatarUrl      String? @map("avatar_url")
  bio            String? @db.Text
  location       String?

  // Настройки приватности
  isPublicProfile Boolean @default(true) @map("is_public_profile")
  showEmail       Boolean @default(false) @map("show_email")
  showPhone       Boolean @default(false) @map("show_phone")

  // Онбординг
  isOnboardingCompleted Boolean @default(false) @map("is_onboarding_completed") // Завершен ли онбординг

  roleId          String       @map("role_id") @db.Uuid
  status          MemberStatus @default(INVITED)
  invitationSent  Boolean      @default(false) @map("invitation_sent")
  invitationToken String?      @unique @map("invitation_token")
  tokenExpiresAt  DateTime?    @map("token_expires_at")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         OrganizationRole @relation(fields: [organizationId, roleId], references: [organizationId, id])
  membership   Membership?

  permissions MemberPermission[]

  // Board relations
  createdBoards       Board[]               @relation("BoardCreator")
  boardMemberships    BoardMember[]
  assignedTasks       BoardTaskAssignee[]   @relation("TaskAssignee")
  assignedByTasks     BoardTaskAssignee[]   @relation("TaskAssignedBy")
  taskComments        BoardTaskComment[]
  uploadedAttachments BoardTaskAttachment[]
  completedItems      BoardChecklistItem[]
  taskActivities      BoardTaskActivity[]
  addedBoardMembers   BoardMember[]         @relation("BoardMemberAddedBy")

  // Blog relations — posts where this member is set as the byline author
  // (Person, not Organization). Backs BlogPosting.author = Person JSON-LD
  // on the public site for E-E-A-T.
  authoredBlogPosts BlogPost[]     @relation("BlogPostAuthor")
  notifications     Notification[]

  @@unique([organizationId, email])
  @@map("organization_members")
}

// ==================== ORGANIZATION ROLE ====================

model OrganizationRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  memberships  Membership[]         @relation("MembershipRole")
  invites      OrganizationInvite[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("organization_roles")
}

// ==================== ORGANIZATION INVITE ====================

/// Приглашение пользователя в организацию. В отличие от устаревшей
/// схемы (invitationToken прямо на OrganizationMember) это самостоятельная
/// сущность: один Account/User может состоять в нескольких организациях,
/// а приглашение существует независимо от staff-записи и хранит токен в
/// виде хэша. См. accept-flow в organizations/invites.
model OrganizationInvite {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Нормализованный (trim + lowercase) email приглашаемого.
  email          String
  /// Снимок: существующий публичный User с этим email на момент создания.
  /// Информативно — accept всё равно сверяет email текущего пользователя.
  userId         String?      @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  status         InviteStatus @default(PENDING)
  /// sha256(rawToken) в hex. Сырой токен живёт только в письме/ссылке.
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")

  // Метаданные приглашённого — используются при создании staff-профиля на accept.
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  position   String?
  department String?

  // Жизненный цикл / аудит
  acceptedAt       DateTime? @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  acceptedMemberId String?   @map("accepted_member_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at")
  /// Отказ приглашённого: когда и (необязательно) почему.
  declinedAt       DateTime? @map("declined_at")
  declineReason    String?   @map("decline_reason")
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         OrganizationRole @relation(fields: [roleId], references: [id])
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([userId])
  @@map("organization_invites")
}

/// Personal invitation to a PRIVATE event. The raw token lives only in the
/// emailed link (`?inviteCode=<token>`); a PENDING invitation opens the event
/// page and admits exactly one registration, which flips it to ACCEPTED.
/// Resend rotates the token, so the previously emailed link stops working.
model EventInvitation {
  id               String       @id @default(uuid()) @db.Uuid
  eventId          String       @map("event_id") @db.Uuid
  /// Normalized (trim + lowercase) recipient email.
  email            String
  status           InviteStatus @default(PENDING)
  /// sha256(rawToken) hex.
  tokenHash        String       @unique @map("token_hash")
  lastSentAt       DateTime     @map("last_sent_at")
  sendCount        Int          @default(1) @map("send_count")
  invitedByUserId  String?      @map("invited_by_user_id") @db.Uuid
  acceptedAt       DateTime?    @map("accepted_at")
  acceptedByUserId String?      @map("accepted_by_user_id") @db.Uuid
  registrationId   String?      @map("registration_id") @db.Uuid
  revokedAt        DateTime?    @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("event_invitations")
}

// ==================== PERMISSION ====================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  category    String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions   RolePermission[]
  memberPermissions MemberPermission[]

  @@map("permissions")
}

// ==================== ROLE PERMISSION ====================

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== MEMBER PERMISSION (дополнительные права) ====================

model MemberPermission {
  memberId     String @map("member_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  member     OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([memberId, permissionId])
  @@map("member_permissions")
}

// ==================== SUPER ADMIN ====================

model SuperAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  platformAdminGrants PlatformAdminGrant[]
  deletedEvents       Event[]
  deletedBlogPosts    BlogPost[]

  @@map("super_admins")
}

// ==================== REFRESH TOKEN (используется как сессия) ====================

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  token               String    @unique
  actorType           UserType  @map("actor_type")
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  lastUsedAt          DateTime  @default(now()) @map("last_used_at")
  familyId            String    @default(uuid()) @map("family_id") @db.Uuid
  consumedAt          DateTime? @map("consumed_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  expiresAt           DateTime  @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  accountId String @map("account_id") @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ==================== EVENT ====================

model Event {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  rentalPlaceId       String?         @map("rental_place_id") @db.Uuid
  slug                String          @unique // SEO-friendly URL slug
  title               String
  description         Json? // BlockNote document JSON (Block[])
  shortDescription    String?         @map("short_description")
  translations        Json            @default("{}")
  translationMeta     Json            @default("{}") @map("translation_meta")
  richTranslations    Json            @default("{}") @map("rich_translations")
  richTranslationMeta Json            @default("{}") @map("rich_translation_meta")
  coverImage          String?         @map("cover_image")
  type                EventType       @default(FREE)
  accessType          EventAccessType @default(OPEN) @map("access_type")
  format              EventFormat
  status              EventStatus     @default(DRAFT)

  // Даты
  startDate            DateTime  @map("start_date")
  endDate              DateTime  @map("end_date")
  registrationDeadline DateTime? @map("registration_deadline")
  /// IANA-таймзона события ('Asia/Tashkent'). NULL = платформенный дефолт
  /// (PlatformSetting 'platform.timezone', сид 'Asia/Tashkent'). Нужна цепочкам
  /// REM/CLS/SUM: «T−24h в TZ события» и quiet hours (OQ-18: UI не делаем).
  timezone             String?

  // Место проведения
  venue     String? // Название места (для offline/hybrid)
  address   String? // Адрес (для offline/hybrid)
  city      String?
  latitude  Decimal? @db.Decimal(9, 6) // Широта (для карты, напр. Yandex Maps)
  longitude Decimal? @db.Decimal(9, 6) // Долгота
  placeId   String?  @map("place_id") // ID места в Yandex (опционально)
  onlineUrl String?  @map("online_url") // Ссылка (для online/hybrid)

  // Стоимость
  price    Decimal? @db.Decimal(10, 2)
  currency Currency @default(UZS)

  // Настройки
  maxParticipants Int?    @map("max_participants")
  inviteCode      String? @unique @map("invite_code") // Код приглашения для INVITE_ONLY событий

  // Ручной переключатель регистрации (имеет приоритет над автологикой: дедлайн, капасити)
  registrationOpen Boolean @default(true) @map("registration_open")

  // Модерация
  rejectionReason String? @map("rejection_reason") @db.Text // Причина отклонения модератором

  /// Момент ПЕРВОЙ публикации. Не сбрасывается при возврате в DRAFT/повторной
  /// модерации: это отметка «событие когда-то было в эфире». По ней организатор
  /// может завершить прошедшее событие, даже если оно уехало в черновик.
  publishedAt DateTime? @map("published_at")

  // Топовое событие (отмечается супер-админом)
  isFeatured Boolean @default(false) @map("is_featured")

  // Счётчик публичных просмотров (инкремент при открытии публичной страницы по slug)
  viewsCount Int @default(0) @map("views_count")

  // Удаление супер-админом (soft delete)
  deletedAt             DateTime? @map("deleted_at")
  deletedBySuperAdminId String?   @map("deleted_by_super_admin_id") @db.Uuid
  deletionReason        String?   @map("deletion_reason") @db.Text

  // Режим регистрации и тестирование
  registrationMode   RegistrationMode    @default(QUESTIONS) @map("registration_mode")
  testEvaluationType TestEvaluationType? @map("test_evaluation_type")
  minTestScore       Int?                @map("min_test_score") // Минимальный балл для прохождения
  maxTestScore       Int?                @map("max_test_score") // Максимально возможный балл (авторасчет)

  // Настройки комментариев
  commentsEnabled Boolean @default(true) @map("comments_enabled") // Разрешены ли комментарии

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization                     Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rentalPlace                      RentalPlace?                   @relation(fields: [rentalPlaceId], references: [id], onDelete: SetNull)
  // Тематики события (несколько на событие)
  categories                       EventCategory[]                @relation("EventCategories")
  deletedBySuperAdmin              SuperAdmin?                    @relation(fields: [deletedBySuperAdminId], references: [id], onDelete: SetNull)
  speakers                         Speaker[]
  agendaItems                      AgendaItem[]
  registrationQuestions            RegistrationQuestion[]
  registrations                    Registration[]
  registrationFileUploads          RegistrationFileUpload[]
  artifactRecipients               EventRecipient[]
  artifactRecipientSources         EventRecipientSource[]
  artifactRecipientRoles           EventRecipientRole[]
  artifactRecipientRoleAssignments EventRecipientRoleAssignment[]
  boards                           Board[]
  comments                         EventComment[]
  savedByUsers                     SavedEvent[]
  tags                             EventTagAssignment[]
  collections                      EventCollectionItem[]
  certificateTemplates             CertificateTemplate[]
  certificates                     Certificate[]
  badgeTemplates                   BadgeTemplate[]
  rooms                            EventRoom[]
  checkpoints                      EventCheckpoint[]
  ticketOrders                     Order[]                        @relation("EventTicketOrders")
  adPlacements                     AdOrder[]
  invitations                      EventInvitation[]

  @@index([organizationId])
  @@index([status])
  @@index([startDate])
  @@index([isFeatured, startDate]) // Для сортировки топовых событий
  @@index([slug])
  @@index([rentalPlaceId])
  @@map("events")
}

// ==================== RENTAL PLACE ====================

model RentalPlace {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  slug                String            @unique
  title               String
  description         Json? // BlockNote document JSON (Block[])
  shortDescription    String?           @map("short_description") @db.VarChar(500)
  translations        Json              @default("{}")
  translationMeta     Json              @default("{}") @map("translation_meta")
  richTranslations    Json              @default("{}") @map("rich_translations")
  richTranslationMeta Json              @default("{}") @map("rich_translation_meta")
  status              RentalPlaceStatus @default(DRAFT)

  pricePerHour     Decimal? @map("price_per_hour") @db.Decimal(10, 2)
  pricePerDay      Decimal? @map("price_per_day") @db.Decimal(10, 2)
  currency         Currency @default(UZS)
  hourlyConditions String?  @map("hourly_conditions") @db.Text
  dailyConditions  String?  @map("daily_conditions") @db.Text

  capacity     Int?
  amenities    String[] @default([])
  address      String   @db.VarChar(500)
  addressNotes String?  @map("address_notes") @db.VarChar(500)
  city         String?  @db.VarChar(100)
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  placeId      String?  @map("place_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  images          RentalPlaceImage[]
  events          Event[]
  contactRequests ContactRequest[]

  @@index([organizationId])
  @@index([status])
  @@index([city])
  @@index([latitude, longitude])
  @@map("rental_places")
}

model RentalPlaceImage {
  id            String   @id @default(uuid()) @db.Uuid
  rentalPlaceId String   @map("rental_place_id") @db.Uuid
  url           String
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  rentalPlace RentalPlace @relation(fields: [rentalPlaceId], references: [id], onDelete: Cascade)

  @@index([rentalPlaceId, sortOrder])
  @@map("rental_place_images")
}

// ==================== SPEAKER ====================

model Speaker {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  // === Связь с User (для приглашений) ===
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // === Данные спикера (используются если userId = null) ===
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  position     String
  company      String?
  bio          String? @db.Text
  avatarUrl    String? @map("avatar_url")
  linkedinUrl  String? @map("linkedin_url")
  instagramUrl String? @map("instagram_url")
  facebookUrl  String? @map("facebook_url")
  websiteUrl   String? @map("website_url")

  // === Локализация ===
  // translations: { position?: { ru?, uz?, en? }, company?: {…}, bio?: {…} }
  // Скалярные position/company/bio выше — fallback для legacy data и mail templates.
  translations    Json @default("{}")
  translationMeta Json @default("{}") @map("translation_meta")

  // === Система приглашений ===
  invitationStatus SpeakerInvitationStatus @default(NONE) @map("invitation_status")
  invitationToken  String?                 @unique @map("invitation_token")
  tokenExpiresAt   DateTime?               @map("token_expires_at")
  invitedEmail     String?                 @map("invited_email")
  rejectionReason  String?                 @map("rejection_reason") @db.Text

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agendaItems AgendaItem[] @relation("AgendaSpeakers")

  @@index([eventId])
  @@index([userId])
  @@index([invitationToken])
  @@index([invitationStatus])
  @@index([invitedEmail])
  @@map("speakers")
}

// ==================== AGENDA ITEM ====================

model AgendaItem {
  id          String         @id @default(uuid()) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  title       String
  description String?        @db.Text
  type        AgendaItemType
  date        DateTime       @db.Date // День проведения (для многодневных мероприятий)
  startTime   DateTime       @map("start_time") @db.Time
  duration    Int // Длительность в минутах
  location    String? // Локация (для гибридных событий)
  materials   String[] // Массив ссылок на материалы (презентации, документы)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // === Локализация ===
  // translations: { title?: { ru?, uz?, en? }, description?: {…}, location?: {…} }
  // Скалярные title/description/location выше — fallback для legacy data.
  translations    Json @default("{}")
  translationMeta Json @default("{}") @map("translation_meta")

  // materialLabels: { "<material-url>": { ru?, uz?, en? } } — локализованные
  // подписи к ссылкам/файлам в materials[]. При удалении URL ключ чистится.
  materialLabels Json @default("{}") @map("material_labels")

  // === Per-event room (зал) ===
  // FK на EventRoom. Заменяет text-match по location: agenda items внутри
  // одного зала валидируются по roomId. location выше остаётся как scalar
  // снапшот (для писем, PDF, поиска и legacy clients) и синхронизируется
  // с room.name при записи.
  roomId String?    @map("room_id") @db.Uuid
  room   EventRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakers Speaker[] @relation("AgendaSpeakers")

  @@index([eventId])
  @@index([date])
  @@index([roomId])
  @@map("agenda_items")
}

// ==================== EVENT ROOM (зал/сцена внутри события) ====================
// Per-event список залов. Каждый AgendaItem может ссылаться на конкретный
// зал; UI на public/workspace фильтрует agenda через табы по залам.
// Не путать с RentalPlace (org-scoped catalog с прайсингом).
model EventRoom {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  name         String // scalar fallback (computed via pickFallbackTranslation)
  translations Json     @default("{}") // { name?: { ru?, uz?, en? } }
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agendaItems AgendaItem[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("event_rooms")
}

// ==================== REGISTRATION QUESTION ====================

model RegistrationQuestion {
  id         String       @id @default(uuid()) @db.Uuid
  eventId    String       @map("event_id") @db.Uuid
  question   String
  type       QuestionType
  isRequired Boolean      @default(false) @map("is_required")
  options    String[] // Варианты ответов для SELECT и CHECKBOX
  sortOrder  Int          @default(0) @map("sort_order")

  // Категоризация вопросов
  category QuestionCategory @default(OPEN)

  // Для тестов
  points         Int      @default(0) // Вес вопроса в баллах (0 = не учитывается)
  correctAnswer  String?  @map("correct_answer") @db.Text // Правильный ответ для TEXT/TEXTAREA/NUMBER
  correctOptions String[] @default([]) @map("correct_options") // Правильные варианты для SELECT/CHECKBOX

  // Для риторических вопросов
  informationalText String? @map("informational_text") @db.Text // Текст для отображения

  // Для вопросов типа FILE_UPLOAD: настройки поля загрузки файла.
  // Форма: { description?, template?: { url, name, size, mimeType },
  //   maxFileSizeMb, allowedFileTypes: string[], allowMultipleFiles, maxFiles }.
  // null для всех остальных типов вопросов.
  fileUploadConfig Json? @map("file_upload_config")

  // === Локализация ===
  // translations: { question?: { ru?, uz?, en? }, informationalText?: {...},
  //   correctAnswer?: {...} } — для plain-text полей.
  // optionsTranslations: { ru?: string[], uz?: string[], en?: string[] } —
  //   массив вариантов под каждую локаль (длина совпадает с options[]).
  // Скаляры question/informationalText/correctAnswer/options/correctOptions
  // выше — fallback для legacy data; correctOptions всегда сравнивается
  // против scalar options[] (server-side answer evaluation не зависит от
  // того, на какой локали пользователь ответил).
  translations        Json @default("{}")
  translationMeta     Json @default("{}") @map("translation_meta")
  optionsTranslations Json @default("{}") @map("options_translations")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event       Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers     QuestionAnswer[]
  fileUploads RegistrationFileUpload[]

  @@index([eventId])
  @@map("registration_questions")
}

// ==================== REGISTRATION ====================

model Registration {
  id              String             @id @default(uuid()) @db.Uuid
  eventId         String             @map("event_id") @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  status          RegistrationStatus @default(PENDING)
  role            ParticipantRole    @default(PARTICIPANT) // Роль участника (Участник, Спикер, Ментор)
  qrCode          String?            @unique @map("qr_code") // Уникальный код для QR
  rejectionReason String?            @map("rejection_reason")

  // E-ticket: человекочитаемый номер билета (EVF-YYMMDD-XXXXXX), идемпотентен
  ticketNumber      String?   @unique @map("ticket_number")
  ticketIssuedAt    DateTime? @map("ticket_issued_at")
  // QR signing: версия payload для revoke без ротации глобального секрета
  qrPayloadVersion  Int       @default(1) @map("qr_payload_version")
  qrSecretRotatedAt DateTime? @map("qr_secret_rotated_at")

  // Даты для календаря
  travelStartDate DateTime? @map("travel_start_date") @db.Date // Начало перелёта/дороги
  travelEndDate   DateTime? @map("travel_end_date") @db.Date // Конец перелёта/дороги
  preparationDays Int       @default(0) @map("preparation_days") // Количество дней на подготовку до события

  // Результаты тестирования
  testScore       Int?      @map("test_score") // Набранные баллы
  testMaxScore    Int?      @map("test_max_score") // Максимально возможные баллы
  testPassed      Boolean?  @map("test_passed") // Прошел ли тест
  testCompletedAt DateTime? @map("test_completed_at") // Когда завершил тест

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event       Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     QuestionAnswer[]
  ticketOrder Order?                   @relation("RegistrationTicketOrder")
  fileUploads RegistrationFileUpload[]
  attendances Attendance[]
  certificate Certificate?
  tickets     TicketArtifact[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([role])
  // Hot path: "approved/pending registrations for this event" (eventId + status).
  @@index([eventId, status])
  @@map("registrations")
}

