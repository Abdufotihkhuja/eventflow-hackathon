# ==================== ENVIRONMENT ====================
NODE_ENV=production
PORT=3000

# ==================== DATABASE ====================
# PostgreSQL credentials
POSTGRES_USER=eventflow_prod
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
POSTGRES_DB=eventflow_prod

# Database connection URL
# Для Docker Compose используйте имя сервиса "postgres"
# Для локальной разработки используйте "localhost"
DATABASE_URL=postgresql://eventflow_prod:ВАШ_ПАРОЛЬ@postgres:5432/eventflow_prod?schema=public
UPLOADS_DIR=/data/uploads

# ==================== JWT AUTHENTICATION ====================
# Генерируйте случайную строку командой: openssl rand -base64 48
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==================== CORS ====================
# Разрешенные origins для CORS (через запятую без пробелов)
# Для production указывайте только нужные домены
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==================== GOOGLE OAUTH ====================
# Получите на: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback

# ==================== LINKEDIN OAUTH ====================
# Получите на: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/linkedin/callback

# ==================== ПРИМЕЧАНИЯ ====================
# 1. Скопируйте этот файл в .env: cp .env.example .env
# 2. Замените все значения-заглушки на реальные
# 3. Никогда не коммитьте .env файл в Git!
# 4. Для генерации JWT_SECRET используйте: openssl rand -base64 48
# 5. Для генерации POSTGRES_PASSWORD используйте: openssl rand -base64 24
# 6. В production обязательно используйте HTTPS для CALLBACK_URL

# ==================== EMAIL (SMTP) ====================
# Настройки SMTP сервера для отправки писем
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM="EventFlow <noreply@eventflow.com>"

# ==================== PUSH (Expo Push Service) ====================
# Тумблер push-канала (BL-14). Включать ТОЛЬКО после загрузки FCM/APNs-кредов
# в Expo-проект (BL-12): выключенный канал мягко деградирует в email-fallback.
EXPO_PUSH_ENABLED=false
# Нужен, только если в Expo-проекте включён Enhanced Security for Push.
# EXPO_ACCESS_TOKEN=

# ==================== FRONTEND URL (check-in, письма, OAuth) ====================
# Один домен (если app и публичный сайт совпадают):
# FRONTEND_URL=https://yourdomain.com
# Два домена (eventflow.uz + app.eventflow.uz):
# QR билета (сканирует организатор) → открывается app
FRONTEND_APP_URL=https://app.eventflow.uz
# «Один QR для всех» (сканируют участники) → открывается публичный сайт
FRONTEND_PUBLIC_URL=https://eventflow.uz
# Для OAuth/писем используется FRONTEND_APP_URL или FRONTEND_URL при отсутствии APP
FRONTEND_URL=https://app.eventflow.uz

# ==================== TICKET QR SIGNING ====================
# Секрет для подписи QR-payload билетов (HMAC-SHA256). Минимум 32 байта случайных данных.
# Сгенерируйте: openssl rand -base64 48
# В production обязателен; при отсутствии backend упадёт при boot.
TICKET_QR_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА_HMAC_TICKET_QR
