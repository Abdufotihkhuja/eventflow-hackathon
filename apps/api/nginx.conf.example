# ============================================
# Nginx Configuration для EventFlow
# Frontend + Backend на одном домене
# ============================================
#
# Структура:
# - yourdomain.uz/          -> Frontend (Next.js/React)
# - yourdomain.uz/api/      -> Backend (NestJS)
# - yourdomain.uz/uploads/  -> Статические файлы
#
# ⚠️ ИНСТРУКЦИЯ:
# 1. Скопируйте: sudo cp nginx.conf.example /etc/nginx/sites-available/eventflow
# 2. Замените yourdomain.uz на ваш домен: sed -i 's/yourdomain.uz/ВАШ_ДОМЕН/g' /etc/nginx/sites-available/eventflow
# 3. Создайте симлинк: sudo ln -s /etc/nginx/sites-available/eventflow /etc/nginx/sites-enabled/
# 4. Создайте директорию для certbot: sudo mkdir -p /var/www/certbot
# 5. Проверьте: sudo nginx -t
# 6. Перезагрузите: sudo systemctl reload nginx
# 7. Получите SSL: sudo certbot --nginx -d yourdomain.uz
#
# После certbot автоматически модифицирует конфиг, добавив SSL настройки.

# Ограничение количества запросов
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

# Upstream для бэкенда
upstream eventflow_api {
    server localhost:3000;
    keepalive 32;
}

# HTTP сервер (certbot автоматически добавит редирект на HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.uz;

    # Let's Encrypt verification
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # ==================== LOGGING ====================
    access_log /var/log/nginx/eventflow_access.log;
    error_log /var/log/nginx/eventflow_error.log warn;

    # ==================== CLIENT SETTINGS ====================
    client_max_body_size 10M;
    client_body_buffer_size 128k;

    # ==================== GZIP ====================
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        image/svg+xml;

    # ==================== BACKEND API ====================
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://eventflow_api;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_cache_bypass $http_upgrade;
    }

    # Rate limiting для auth эндпоинтов
    location ~ ^/api/v1/auth/(login|register) {
        limit_req zone=auth_limit burst=3 nodelay;
        limit_req_status 429;

        proxy_pass http://eventflow_api;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Swagger документация
    location ~ ^/api/docs(/|$) {
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://eventflow_api;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==================== UPLOADS (статика) ====================
    location /uploads/ {
        alias /var/lib/docker/volumes/eventflow_back_uploads_data/_data/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Origin "*" always;

        # Защита от выполнения скриптов
        location ~* \.(php|py|pl|sh|cgi)$ {
            deny all;
        }
    }

    # ==================== FRONTEND ====================
    # Замените /var/www/eventflow/frontend на путь к вашему фронтенду
    root /var/www/eventflow/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Статика фронтенда с кэшированием
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ==================== HEALTH CHECK ====================
    location = /health {
        access_log off;
        proxy_pass http://eventflow_api/api/v1;
    }

    # ==================== ERROR PAGES ====================
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
