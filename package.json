{
  "name": "eventflow-platform",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run docker:up",
    "postinstall": "npm --workspace @eventflow/api run db:generate",
    "iam:backfill": "npm --workspace @eventflow/api run iam:backfill",
    "iam:preflight": "npm --workspace @eventflow/api run iam:preflight",
    "openapi:export": "npm --workspace @eventflow/api run openapi:export",
    "contracts:generate": "npm run openapi:export && npm --workspace @eventflow/api-contracts run generate",
    "contracts:check": "npm run openapi:export && npm --workspace @eventflow/api-contracts run check",
    "contracts:verify": "node ./scripts/check-contracts-drift.mjs",
    "ratchet:tenant-guard": "node ./scripts/check-tenant-guard.mjs",
    "ratchet:notification-dispatch": "node ./scripts/check-notification-dispatch.mjs",
    "ratchet": "npm run ratchet:tenant-guard && npm run ratchet:notification-dispatch",
    "i18n:scan": "npm --workspace @eventflow/i18n run i18n:scan",
    "build:packages": "npm --if-present --workspace @eventflow/ui-tokens --workspace @eventflow/api-contracts --workspace @eventflow/i18n --workspace @eventflow/sdk-public --workspace @eventflow/sdk-account --workspace @eventflow/sdk-workspace --workspace @eventflow/sdk-admin run build",
    "build:apps": "npm --if-present --workspace @eventflow/api --workspace @eventflow/worker --workspace @eventflow/web-public --workspace @eventflow/web-workspace --workspace @eventflow/web-admin run build",
    "build": "npm run contracts:generate && npm run build:packages && npm run build:apps",
    "clean:packages": "node ./scripts/clean-packages.mjs",
    "clean:packages:dry": "node ./scripts/clean-packages.mjs --dry-run",
    "lint": "npm --if-present --workspace @eventflow/api --workspace @eventflow/web-public --workspace @eventflow/web-workspace --workspace @eventflow/web-admin --workspace @eventflow/mobile run lint",
    "lint:api": "npm --workspace @eventflow/api run lint",
    "lint:public": "npm --workspace @eventflow/web-public run lint",
    "lint:workspace": "npm --workspace @eventflow/web-workspace run lint",
    "lint:admin": "npm --workspace @eventflow/web-admin run lint",
    "lint:mobile": "npm --workspace @eventflow/mobile run lint",
    "test": "npm --if-present --workspace @eventflow/api --workspace @eventflow/mobile run test",
    "test:api": "npm --if-present --workspace @eventflow/api run test",
    "test:mobile": "npm --workspace @eventflow/mobile run test",
    "type-check": "npm run contracts:generate && npm --workspaces --if-present run type-check",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": "^10.9.0"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.2",
    "@tailwindcss/postcss": "4.1.16",
    "@tanstack/react-query": "5.90.6",
    "@tanstack/react-query-devtools": "5.90.6",
    "@types/node": "22.10.7",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.81.5",
    "react-test-renderer": "19.2.4",
    "react-hook-form": "7.66.0",
    "tailwindcss": "4.1.16",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "zod": "4.1.12",
    "mjml": "5.4.0",
    "liquidjs": "10.27.2",
    "multer": "2.2.0",
    "form-data": "4.0.6",
    "undici": "6.27.0",
    "path-to-regexp": "8.4.2",
    "lodash": "4.18.1",
    "fast-uri": "3.1.3",
    "mailparser": "3.9.14",
    "tmp": "0.2.7",
    "qs": "6.15.3",
    "fast-xml-parser": "4.5.7",
    "serialize-javascript": "6.0.2",
    "minimatch": "9.0.9",
    "picomatch": "4.0.5",
    "js-cookie": "3.0.8",
    "linkify-it": "5.0.2",
    "@eventflow/mobile": {
      "tailwindcss": "3.4.18"
    },
    "handlebars": "4.7.9",
    "nodemailer": "9.0.3",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/core": "^7.21.11",
    "@react-navigation/elements": "^2.9.36"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-linux-arm64-musl": "1.32.0"
  },
  "dependencies": {
    "expo-image-picker": "~17.0.11"
  }
}
