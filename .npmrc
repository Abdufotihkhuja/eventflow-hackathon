# Версия npm зафиксирована: лок-файл резолвится по-разному в npm 10 и 11
# (npm 11 не пишет вложенные записи для точных пинов, а npm 10 их требует),
# и CI вместе со всеми node:22-alpine образами работает на npm 10.
# engine-strict заставляет npm упасть сразу, а не молча переписать лок.
engine-strict=true
